@import "../driver-chart/driver-chart.wxss";
page{
    background:whitesmoke
}
.coin_bg{
    width: 100%;
    height: 200px;
    background:#188df0;
    color: white;
    padding-top: 50rpx;
    box-sizing: border-box;
    text-align: center;
    display: flex;
    flex-direction: column;
}
.customer{
    margin-top: 25rpx;
    display:flex;
    justify-content: center;
    color: orange;
    font-weight: bold;
}
.customer view{
    white-space: nowrap;
    width: 500rpx;
    overflow: scroll;
}
.filterBox{
    width: 80%;
    height: 80rpx;
    line-height: 80rpx;
    padding: 0 20rpx;
    white-space: nowrap;
    overflow: scroll;
    background:white;
}
.filterItem{
    height: 60rpx;
    line-height: 60rpx;
    display: inline;
    background-color: #188df0;
    color: white;
    margin:0 5rpx;
    padding: 10rpx 10rpx;
    border-radius: 30rpx;
}

.detailBox{
    top:0;
    height: 500rpx;
    padding:50rpx 0;
    display: flex;
    align-items: center;
    flex-direction: column;
    overflow: scroll;
}
.detailTop{
    display: flex;
    align-items: center;
    height: 50rpx;
}
.detailTop image{
    width: 50rpx;
    height: 50rpx;
}
.detailTop text{
    font-size: 40rpx;
    font-weight: bold;
    color: #188df0;
}
.detailBody{
    margin-top: 50rpx;
    width: 100%;
    height: 100%;
    color: #188df0;
    padding: 0 50rpx;
}
.fbox{
    margin-top: 20rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
}
.filterLabel{
    background: white;
    height: 80rpx;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}
.filterLabel image{
    width: 50rpx;
    height: 50rpx;
}
.pcFilter{
    max-height: 1000rpx;
    background: white;
    padding: 50rpx 50rpx;
    overflow: hidden;
}
.pcFilter>view{
    max-height: 720rpx;
    overflow: scroll;
}
.pcFilter_item{
    width: auto;
    height: 60rpx;
    line-height: 60rpx;
    display: inline-block;
    background: #5dabeb;
    border-radius: 30rpx;
    padding: 0 20rpx;
    color: white;
    margin: 5rpx;
}
.pcFilter>button{
    width: 100%;
    height: 80rpx;
    line-height: 80rpx;
    margin-top: 50rpx;
    background: #188df0;
    color: white;
}
.checked{
    background: #188df0;
    font-weight: bold;
}