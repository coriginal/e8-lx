/* pages-charts/driver-chart/driver-chart.wxss */
page{
    background: white;
}
.bar {
    background-color: white;
    width: 100%;
    box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
    padding: 20rpx;
}

.bar .title {
    display: flex;
    align-items: center;
}

.customer-choose {
    font-size: 28rpx;
    margin: 0 20rpx;
    flex: 1;
}

.search-form {
    background: #f5f5f5;
    line-height: 64rpx;
    height: 64rpx;
    font-size: 24rpx;
    color: #666;
    display: flex;
    align-items: center;
    border-radius: 10rpx;
}

.search-form view {
    margin: 0 15rpx;
}

.search-form input {
    flex: 1;
    padding-right: 20rpx;
    font-size: 26rpx;
}

.customer_list {
    margin-top: 30rpx;
    /* padding: 0 20rpx; */
    margin-bottom: 0rpx;
}

.customer_panel {
    padding: 10rpx 20rpx;
    background-color: white;
    /* border-radius: 6rpx; */
    /* margin-top: 15rpx; */
    /* min-height: 128rpx; */
    /* box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1); */
    border-bottom: 1px solid#eee;
}

.customer_panel .head {
    display: flex;
    /* justify-content: space-between; */
    align-items: center;
}

.type-detail {
    padding-left: 30rpx;
    color: #5a6b92;
    font-size: 13px;
}

.name {
    /* flex: 1; */
    /* white-space: nowrap; */
    font-size: 32rpx;
}

/* .name::first-letter {
    font-size: 36rpx;
    margin-right: 1px;
  } */
.flex-1 {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;

}

.head .type {
    /* flex: 2; */
    text-align: right;
    display: flex;
    justify-content: flex-end;
}

.head text {
    margin-right: 15rpx;
}

.type text {
    font-size: 24rpx;
    border: 2rpx solid #eee;
    padding: 10rpx;
    border-radius: 10rpx;
}

.foot {
    font-size: 26rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.foot .detail {
    color: #3f5075;
    /* flex: 1; */
}

.content .addr {
    color: #888;
    font-size: 24rpx;
}

.foot,
.content,
.head {
    padding: 10rpx 0;
}

.foot {
    padding: 10rpx 0 0 0;
}

.tags {
    margin-top: 20rpx;
    white-space: nowrap;
    overflow: scroll;
    -webkit-overflow-scrolling: touch;
}

.tags view {
    font-size: 20rpx;
}

.btn.detail {
    background-color: transparent;
    text-align: left;
    font-size: 24rpx;
    justify-content: flex-start;
    transform: none;
    margin: 0;
}

.choose {
    color: #3f5075;
    background-color: transparent;
    font-size: 24rpx;
    margin: 0;
}

.bottom-btn {
    position: fixed;
    bottom: 0;
    width: 100%;
    display: flex;
    padding: 30rpx 0;
    background-color: white;
}

.m-p {
    margin: 0 20rpx;
    padding: 20rpx 32rpx;
    border-radius: 6rpx;
    height: 84rpx;
    font-weight: 500;
    flex: 1;
}

.more-menu {
    display: flex;
    align-items: center;
}

.round {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    height: 100%;
    justify-content: space-around;
    padding: 20rpx 0;
}

.flex-icon {
    height: 96rpx;
    width: 96rpx;
    border-radius: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    margin: 20rpx;
}

.hover-round {
    background-color: #eee;
    opacity: 0.7;
}

.padding.cancel {
    padding: 20rpx;
    border-top: 1rpx solid#eee;
}

.i-more {
    width: 64rpx;
    text-align: center;
    opacity: 0.7;
}


.customer_list {
    width: 100%;
}

.customer_panel {
    padding: 10rpx 40rpx;
}

.container {
    width: 100%;
    background-color: white;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
    padding-top: 90rpx;
}

#mychart-dom-bar {
    width: 100%;
    height: 300px;
    display: block;
}

#mychart-dom-pie {
    margin-top: 80rpx;
    width: 100%;
    height: 250px;
    display: block;
}
#mychart-dom-line{
    width: 100%;
    height: 300px;
    margin-bottom: -100rpx;
    display: block;
    margin-top: 20rpx;
}
.section {
    width: 100%;
    height: 5%;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    padding: 5px;
}

.choosedate {
    margin-left: 20rpx;
    flex: 1;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    border-radius: 10px;
    padding: 5px;
    background: #188df0;
    color: white;
}

.section__title {
    font-size: 36rpx;
}

.picker {
    flex: 1;
    font-size: 30rpx;
    text-align: center;
}

.detail-page {
    width: 100%;
    height: 100%;
    min-height: 300px;
    display: flex;
    align-items: center;
    flex-direction: column;
}

.show_button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 45rpx;
    font-size: 28rpx;
}

.switchContainer {
    padding: 10rpx;
    width: 100%;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    height: auto;
    padding-bottom: 20rpx;
}

.switch {
    position: relative;
    transform: scale(0.8);
}
.toplist{
    height: 90rpx;
    width: 100%;
    background:#188df0;
    display: flex;
    box-shadow: 0 0 5px black;
    position: absolute;
}
.toplist div{
    flex:1;
    color: white;
    text-align: center;
    height: 90rpx;
    line-height: 90rpx;
    font-size: 36rpx;
    box-sizing: border-box;
}

.toplistchecked{
    border-bottom: 3px white solid;
    font-weight: bold;
}
.page2{
    background: whitesmoke;
    min-height: 100vh;
}
.coin_bg{
    width: 100%;
    height: 200px;
    background:#188df0;
    color: white;
    padding-top: 110rpx;
    box-sizing: border-box;
    text-align: center;
    display: flex;
    flex-direction: column;
}
.coin_bg view:nth-child(2){
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding:0 30rpx;
}
.box{
    width: 92%;
    margin: 0 auto;
    height: 80px;
    background: white;
    margin-top: -40px;
    box-shadow: 0 0 3px black;
    border-radius: 3px;
}
.coin_order_list{
    width: 100%;
    display: flex;
    flex-direction: column;
    padding:30rpx 0;
}
/**height:160px*/
.coin_order_item{
    width: 92%;
    height: 40px;
    background: white;
    margin: 5rpx auto;
    border-radius: 3px;
    padding:20rpx;
}
.point{
    height: 5px;
    width: 5px;
    border-radius: 2.5px;
    margin-right: 10rpx;
}
.title{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.box{
    display: grid;
    grid-template-columns: repeat(3,33.3%);
    place-items: center center;
}
.box>view{
    display: flex;
    flex-direction: column;
}
.box>view view:nth-child(1){
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.box>view view:nth-child(1) text{
    font-size: 38rpx;
}
.box>view view:nth-child(2){
    color: gray;
}
.coin_search{
    height: 80rpx;
    width: 92%;
    background: white;
    margin: 20rpx auto -10rpx;
    border-radius: 20rpx;
    display: flex;
    align-content: center;
    align-items: center;
    padding: 30rpx;
}
.coin_search input{
    margin-left: 20rpx;
    flex:1;
}