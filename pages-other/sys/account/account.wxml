<view class="account-content">
  <view class="bg-account shadow-blur">
    <view class="t-f36">我的余额</view>
    <view class="t-f48 t-fw">{{balance}}</view>
    <view class="free-content">
      <view class="flex-b">
        <text class="op-7">赠送金额：</text>
        <text>¥{{balance2}}</text>
      </view>
      <view class="flex-b">
        <text class="op-7">本金：</text>
        <text>¥{{balance1}}</text>
      </view>
    </view>
  </view>
  <view class="my-system-options">
    <view class="my-system-menu" wx:for="{{_options}}" wx:key bindtap="goFlow" id="{{item.type}}">
      <view class="left-view">
        <icon size='30' type='i-{{item.icon}}' />{{item.name}}
      </view>
      <view class="right-view">
        <view class="my-system-notice">{{item.notice}}</view>
        <icon size='30' color="gray" type='i-right' />
      </view>
    </view>
  </view>

  <view class="redpacket-view" hover-class="translate" bindtap="goRedPacket">
    <image class="redpacket-img" mode="widthFix" src="{{redpacket}}"></image>
  </view>
