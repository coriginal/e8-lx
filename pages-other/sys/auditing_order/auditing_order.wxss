.wux-badge__count {
  top: -13px !important;
  right: -16px !important;
}

.list {
  padding: 0 20rpx;
  margin-bottom: 156rpx;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 30rpx 0;
  background-color: white;
  z-index: 999;
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
  flex: 1;
}

.flex-1 {
  flex: 1;
}

.list .panel {
  padding: 10rpx 20rpx;
  background-color: white;
  border-radius: 6rpx;
  margin-top: 15rpx;
  font-size: 26rpx;
  flex: 1;
}

.panel .head {
  display: flex;
  align-items: center;
  line-height: 64rpx;
  /* border-bottom: 2rpx solid #eee; */
}

.head .detail {
  color: #5a6b92;
}

.panel .content {
  /* border-bottom: 1px solid #eee; */
  margin-top: 10rpx;
}

.content .city {
  min-height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}


.content-left,
.content-right {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 50%;
  text-align: left;
}

.content-center image {
  width: 48rpx;
  height: auto;
}

.opcity {
  opacity: .7;
}

.t-f32 {
  font-size: 36rpx;
  margin: 0 20rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

.text-center {
  margin: 0 20rpx;
}

.center-view {
  display: flex;
  align-items: center;
}

.panel .foot {
  font-size: 24rpx;
  line-height: 64rpx;
  color: grey;
  text-align: right;
}

.shadow {
  box-shadow: var(--shadowSize) var(--blackShadow);
}

.margin-text {
  margin: 0 10rpx;
}

.slot-view {
  padding: 0 20rpx;
  color: #444;
  font-size: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.slot-view view {
  height: 48rpx;
  line-height: 48rpx;
}

.d-container {
  width: 400rpx;
  padding: 80rpx 30rpx
}

.drawer-view {
  text-align: center;
  padding-bottom: 40rpx;
}

.right-checkbox {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-left: 20rpx;
}

.forgin-panel {
  display: flex;
}

.btn.margin {
  width: 100%;
  height: 84rpx;
  margin: 20rpx 0;
}
.income,.cost{
  font-weight: bold;
  font-size: 40rpx;
}
.choose-month{
  background-color: white;
  padding: 20rpx;
}