video {
  width: 100%;
  height: 480rpx;
}

.options {
  padding: 0 20rpx 0 30rpx;
  margin-bottom: 30rpx;
  background-color: white;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
}

.ops {
  /* height: 200rpx; */
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 20rpx 10rpx;
}

.video {
  white-space: nowrap;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 30rpx 0;
}

.video text {
  border-bottom: 4px solid;
  padding-bottom: 12rpx;
}

.grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
}

.grid view {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  justify-content: center;
}

.text-center {
  text-align: center;
}

.grid.col-3>view {
  width: 33.33%;
  padding: 10rpx;
}

.wux-sticky-item__hd {
  background-color: white !important;
  height: 100rpx !important;
}

.wux-sticky-item__title {
  height: 100rpx;
  line-height: 100rpx;
  border-bottom: 1px solid#eee;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
}

.content-item {
  min-height: 64rpx;
  padding: 0 20rpx;
  background-color: white;
  line-height: 64rpx;
  border-bottom: 1rpx solid #eee;
}

.wux-sticky-item {
  margin-top: 20rpx;
}

.content {
  background-color: white;
}

.title {
  font-weight: bold;
}

.notice {
  opacity: 0.6;
}

.notice-text {
  margin: 0 10rpx;
}

.header-slot {
  height: 40rpx;
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 6rpx;
}

.wux-cell__text {
  font-size: 26rpx;
}

.text-red {
  color: var(--red);
  font-weight: bold;
}

.wux-cell__desc {
  font-size: 20rpx!important;
  opacity: 0.7
}
