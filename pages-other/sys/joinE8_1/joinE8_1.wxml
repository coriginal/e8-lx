<view class="bottom-btn">
  <view class="flex-1">
    <checkbox-group bindchange="checkboxChange">
      <view class="bg-trans flex">
        <checkbox color="var(--blue)" class='checkbox' value="true" ></checkbox>
        <view class='text-df xieyi margin-left-xs'>我已阅读并同意
          <text class='text-red' bindtap='getAgreement'>《注册协议》</text>
        </view>
      </view>
    </checkbox-group>
    <view class=" payfor">认证金额：
      <text class="text-red text-big">{{priceInfo.money_cal||' - '}}元</text>
    </view>
  </view>

  <button class="btn bg-red " bindtap="payFor">确认支付</button>
</view>



<wxs module="fn">
  var contact = function(value) {
    if (value) {
      var con = value.filter(function(n) {
        return n
      }).join(' ')
      return con
    }
  };
  module.exports.contact = contact;
</wxs>