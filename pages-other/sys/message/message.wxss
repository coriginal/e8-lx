.msg-panel {
  background-color: white;
  margin: 20rpx 30rpx;
  padding: 20rpx;
  height: 248rpx;
  border-radius: 10rpx;
  box-shadow: 2rpx 4rpx 6rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
}

.content {
  display: flex;
  padding: 15rpx;
  align-items: center;
  flex: 1;
}

.content-text {
  color: gray;
  font-size: 26rpx;
  opacity: 0.8;
}

.foot {
  display: flex;
  align-items: center;
  font-size: 13px;
  padding: 15rpx;
}

.foot-text {
  color: grey;
  font-size: 12px;
}

.margin-lr {
  margin-left: 20rpx;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: white;
}

.btn {
  height: 84rpx;
  width: 100%;
}

.options-panel {
  margin-bottom: 156rpx;
}