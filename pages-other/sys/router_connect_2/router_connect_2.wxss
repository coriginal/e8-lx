.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 84rpx;
}

.bar input {
  flex: 1;
  font-size: 28rpx;
}

.bar picker {
  flex: 1;
}

.index {
  flex:1;
  text-align: right;
  font-size: 12px;
  opacity: 0.5;
}

.bar .title {
  padding-right: 30rpx;
  font-size: 26rpx;
}

.addr {
  padding: 20rpx;
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
}

.i-scan,.i-right {
  padding: 0 20rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.flex {
  display: flex;
  line-height: 32px;
}

.switch-pick {
  margin: 0 20rpx;
  position: relative;
  transform: scale(0.8);
}

.switch-pick::after {
  content: "是";
}

.switch-pick::before {
  content: "否";
}

.margin-bottom{
  margin-bottom: 154rpx;
}



.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 30rpx 0;
  background-color: white;
  z-index: 999;
}

.bottom-btn button {
  height: 84rpx;
}


.flex-1 {
  flex: 1;
}

.text-blue {
  background-color: transparent;
  border: 1px solid var(--blue);
}


.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
}

.sub-icon-padding {
  padding: 0 15rpx;
  height: 100%;
  display: flex;
  align-items: center;
}