.picker {
  z-index: 12;
}
.picker .picker-action {
  position:fixed;
  height: 40px;
  bottom: 270px;
  left:0;
  width: 100%;
  display: flex;
  align-items: center;
  background: #fff;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e5e5e5;
  border-top: 1rpx solid #e5e5e5;
  justify-content: space-between;
  z-index:12;
  font-size:16px;
}
.picker-action view:first-child {
  padding: 9px 30px 9px 15px;
}
.picker-action view:last-child {
  color: #1aad16;
  padding: 9px 15px 9px 30px;
}
.popview{
  position: fixed;
  bottom: 0;
  left:0;
  background: #fff;
  width: 100vw;
  z-index:12;
}
.popview{
  width: 100%;
  height: 270px;
  text-align:center;
  font-size: 16px;
}
/* 搜索框提示文字样式 */
.search input
{
  font-size:14px;
  font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  padding:7px 15px; 
  /* border:1rpx solid #ccc; */
}

/* 搜索框小图标 */
.search image
{ 
  width:40rpx;
  height:40rpx;
  padding-right:20rpx;
}
.modal-mask {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 11;
  color: #fff;
}
