.tips-control-background{
  position: fixed;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background:#616161;
  opacity: 0.8;
}
.tips-control-wrap{
  background: #fff;
  margin:0 80rpx 0 80rpx;
  border-radius: 8rpx;
  font-family: "Microsoft YaHei" ! important;
  transform: translateY(100%);
}
.tips-control-mainimg{
  height: 90rpx;width: 90rpx;padding: 4% 0% 0% calc((100% - 50px)/2);
}
.tips-control-cancel{
  height: 36rpx;width: 36rpx;
  position: absolute;right: 3%;top: 3%;
}
.tips-area-title{
  line-height: 100rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
}
.tips-area-content{
  text-align: center;
  font-size: 32rpx;
  padding: 8rpx;
  margin: 8rpx;
  color: #555;
}
.tips-area-icon{
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0 30rpx 0;
}
.tips-area-icon-{
  padding: 8rpx 80rpx ;
  text-align: center;
}
.tips-area-subicon{
  text-align: center;
  padding: 0 0 30rpx 0;
  font-size: 32rpx;
}
.green{
  color: green;
  border: 1px solid green;
}
.greenbac{
  background: green;
  color: #fff;
}
.greentext{
  color: green;
}
.orange{
  color: orangered;
  border: 1px solid orangered
}
.orangebac{
  background: orangered;
  color: #fff;
}
