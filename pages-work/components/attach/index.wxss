.attachline{
  display: flex;  
  background-color: #fff;
  padding: 0 15rpx;
  position:relative;
  flex-wrap:wrap;
}
.attachcell{
  height:150rpx;
  width: 150rpx;
  line-height: 100rpx;
  text-align: center;
  font-size:15px;
  margin:30rpx 15rpx;
  position:relative;
  background-color:#eee;
  display: inline-block;
}
.notopmargin{
  margin-top:0;
}
.nobottommargin{
  margin-bottom:0;
}
.plus{
  font-size:25px;
  color:#eee;
}
.delete {
  width:50rpx;
  height:50rpx;
  position: absolute;
  right: -15rpx;
  top:-15rpx;
}
.attach {
  width: 100%;
  height: 100%;
  
} 
.addattach{
  /* width: 45rpx;
  height: 45rpx;
  top:35rpx;
  position:relative; */
  width: 45rpx;
height: 45rpx;
top: 55rpx;
display: inline-block;
position: absolute;
left: 55rpx;
}
.image{
  display:inline;
}
.attach_docname{
  font-size: 15px;
  line-height: 15px;
  word-break: break-all;
  position:absolute;
  top:0;
  font-weight: bold;
}
.scroll_w{
  min-width: 100%;
  white-space: nowrap;
}