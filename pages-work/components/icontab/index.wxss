.box{
  position:fixed;
  bottom:0;
  width:100%;
  display:flex;
  flex-direction:row;
  border-top:1rpx solid #e5e5e5;
  background:#f9f9f9;
}
.cell{
  flex:1;
  display:inline-block;
  padding:5px;
  box-sizing:border-box;
  overflow:hidden;
  text-align:center;
}
.image{
  width:25px;
  height:25px;
  display:inline-block;
}
.text{
  font-size:10px;
}
