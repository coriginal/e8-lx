<!--components/modal/modal.wxml-->
<view class='mask' wx:if='{{show}}' bindtap='clickMask'>
  <view class='modal-content' style='height:{{height}}'>
    <view class='modal-title' hidden="{{!title}}">{{title}}</view>
    <scroll-view scroll-y class='main-content'>
      <slot></slot>
    </scroll-view>
    <view class='modal-btn-wrapper'>
      <view class='cancel-btn' style='color:rgba(7,17,27,0.6)' bindtap='cancel' hidden="{{hideCancel}}">取消</view>
      <view class='confirm-btn' style='color:#3CC51F' bindtap='confirm' hidden="{{hideConfirm}}" data-show-modal="{{showModal}}">确定</view>
    </view>
  </view>
</view>