.modal-title {
  font-size: 36rpx;
  text-align: center;
  padding: 26rpx;
  border-bottom: 1px solid #f1f3f5;
  color: #000;
  font-weight: bold;
}
.modal-content {
  padding: 10rpx;
  line-height:2;
  font-size:32rpx;
}
.modal-mask{
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 9000;
  color: #fff;
}
.modal-dialog {
  width: 90vw;
  position: fixed;
  top: 20vh;
  left: 5vw;
  z-index: 9999;
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx;
}