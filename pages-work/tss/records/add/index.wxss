.formview {  
  background: #f1f3f5;
}

.header, .footer {
  padding-left: 32rpx;
  padding-right: 32rpx;
  font-size: 28rpx;
  color: #888;
}

.header {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.header::before, .header::after {
  content: '';
  display: table;
}
.btn{
  display:flex;
}
.btn button{
  margin: 20rpx 16rpx 20rpx 16rpx;
}
.delete-btn{
  width:40%;
  background-color:#b32814!important;
}
.submit-btn {
  width:60%;
} 

.value{
  flex:1;
  line-height:1.6;
  padding:4px 0;
  min-height:22px;
  height:auto;
  font-size:14px; 
}

.label,.pickerlabel{
  color:#333;
  min-width:60px;
  padding-right:15px;  
  font-size:14px; 
  display:inline-block;
}
.label{
  text-align:right;
}
.cell .label {
  font-size: 30rpx; color: #9b9b9b;
}

.cell .value {
  font-size: 30rpx; color: #35383c;
}
.line{
  position:relative;
}
.picker{
  background-color:#fff;
  padding:10px 7px 10px 15px;
} 
.picker:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}

.required:after{
  content:' *';
  color:red;
  display:inline; 
}
.datetimeview{
  background-color:#fff;
  padding:10px 7px 10px 15px;
}
.datetimeview:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}
.datetime{
  display:inline-block;
}
.pickerlabel.disabled{
  font-style:italic;
  color:#cdcdcd;
}
.box{
  display: flex;
  flex-direction:row;
  flex-wrap:wrap;
  justify-content: flex-start;
  align-items:flex-start;
  align-content: flex-start;
  background-color: #fff;
  padding:10px 0;
}

.truck_cell{
  display:flex;
  width:33%;
  box-sizing:border-box;
  flex-direction: row;
  flex-wrap:wrap;
  justify-content:space-around;
  align-items:center;
  align-content:space-around;
  padding:5px 0;
}

.cell_item{
  width:80%;
  height:100%;
  padding:5px 0;
  text-align: center;
  border:2rpx solid #eee;
  font-size:14px;
  color:#8e8e8e;
}
.select_item{
  background-color:#fef8ea;
  color:#dca867;
}
.maskLayer {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.2;
  overflow: hidden;
  z-index: 1000;
  color: #fff;
}

.choose {
  width: 100%;
  overflow: hidden;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background: #fff;
  padding-top: 20rpx;
}
.fieldClass:after{
  content:'';
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}
.cellClass:after{
  content:'';
  left:0!important;
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}