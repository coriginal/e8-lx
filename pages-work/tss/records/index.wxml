<nav-bar title="表格"/>
<view class='box'>
  <view class="cell {{ (index+1) % 3 ===0 ? 'right' : ''}}" 
        wx:for="{{ tableList }}" wx:key="item" 
        style="height:{{ cellHeight }}" 
        catchtap='openRecord' 
        data-recordid="{{ item.id}}" 
        data-permissions="{{ item.permissions }}">
    <view>
      <image class='image' 
             wx:if="{{ item.icon }}" 
             src="{{ app_host + item.icon }}" 
             style="height:{{imageHeight}}; width:{{imageHeight}}">
      </image> 
    </view>
    <view class='text'>
      <text>{{item.name}}</text>
    </view>
  </view>
</view>
