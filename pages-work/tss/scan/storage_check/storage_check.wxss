.top{
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 0px 10px 5px 10px;font-size: 17px;
}
.station,.scan,.one,.two,.input,.code,.bottom{ display: flex; }
.stop{ padding-left: 10px; }
b{ padding: 0 5px; color: red;font-weight: bold;font-size: 21px;}

.scan{
  margin-top: 5px;
  background: #fff;
  padding: 10px;
}
.scan input{ font-size: 16px;padding: 5px;width: 90%;height: 38px;
background:#f1f3f5;color:blue;}

.detail{
  background: #fff;
  margin: 5px 5px 0px 5px;
  padding: 10px;
  border-radius: 4px;
}

text{color: #888;padding-left:5px; padding-right:8px;}
.one{ border-bottom: 1px solid #f1f3f5;padding-bottom: 5px;justify-content: space-between;}
.two{flex-wrap: wrap;justify-content: space-evenly;margin-top:10px;padding-bottom: 5px;}
.input{width: 32%;margin-right: 1%;margin-top: 5px;}
.input text{width: 50px;padding-top: 5px;} 
.input input{border: 1px solid #f1f3f5;height: 30px;padding:4px;}
.codenum{font-size: 16px;color: red;font-weight: bold;}

.bottom{
  padding: 7px 10px 13px 10px;background: #fff;margin-top: 80rpx;
  position: fixed;bottom: 0px;right: 0px;left: 0px;z-index: 100;
}
.bottom-btn{
  margin-top: 5px;
  width: 66%;font-size: 17px;
  color: #fff;
  line-height: 74rpx;
}
.opicon{padding-top: 10px;}

.scan_choose image{
  height: 60px;width: 60px;
  border-radius: 100%;background: #fff;
  position: fixed;right: 12px;bottom: 120px;
}
