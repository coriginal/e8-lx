<view class="wrap">
    <form bindsubmit="formSubmit">

        <view class="top" hidden="{{ifContinue}}">
            <view class="station">
                <icon type="i-locationfill" color="#E63939" size="40" bindtap="openSiteList"></icon>
                <input name="station" placeholder="本站" class="stop" bindinput="getValue" data-name="station" value="{{select.station}}"></input>
                <icon type="i-focus" color="#E63939" size="40" bindtap="doLocation"></icon>
            </view>
            <view wx:if="{{select.fields.length}}">
                <field wx:for="{{select.fields}}" wx:key="" title="{{item.name}}" name="{{item.code}}" bindchange="getValue" data-field="{{item.code}}" placeholder="{{item.placeholder}}" value="{{select[item.code]}}" disabled="{{item.disabled||''}}" bindtap="{{item.bindtap||''}}">
                    <icon wx:if="{{item.code == 'task'}}" type="i-unfold" size="40" bindtap="openTaskList" class="unfold"></icon>
                    <icon wx:if="{{item.code=='next_stop'}}" type="i-settingsfill" size='40' bindtap="nextStation"></icon>
                    <icon wx:if="{{item.scan}}" type="i-scan" size="40" bindtap="scanField" data-field="{{item.code}}"></icon>
                </field>
            </view>
            <view class="oldTask-list" hidden="{{listHidden}}">
                <view class="text-list grey">
                    <text>历史任务单</text>
                </view>
                <scroll-view scroll-y="true" class="task-padding" style="height:300rpx;">
                    <view wx:for="{{oldTask}}" wx:key='' bindtap="checkedTask" data-value="{{item.task}}" data-id="{{item.id}}" class="text-list">
                        <text>{{item.task}}</text>
                        <text>{{item.submitTime}}</text>
                        <text class="text-red">类型：{{item.type && item.type}}</text>
                        <text class="text-blue">状态：{{item.status && item.status}}</text>
                    </view>
                </scroll-view>
            </view>
