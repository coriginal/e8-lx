            <view class="customer">
                <text>手工调整</text>
                <input name="scan_hand" placeholder="手动输入单号" data-field="scan_hand" value="{{select.scan_hand}}" confirm-type="done" bindconfirm="handInput"></input>
            </view>

        </view>
        <view class="main_scan">
            <scroll-view scroll-y="true" style="height: 800rpx;" class="body">
                <view wx:for="{{scanData}}" wx:key="" class="text-list" wx:if="{{index < 20}}">
                    <text style="{{item.upload == 1?'color:#57bc81':''}}" class="scan_code">{{item.scan_code}}</text>
                    <icon wx:if="{{item.upload != 1}}" type="i-delete" size="36" bindtap="deleteCode" id="{{index}}" color="grey"></icon>
                    <icon type="i-warn" color="{{item.ifRegit?'red':'grey'}}" bindtap="abnormalReport" data-code="{{item.scan_code}}" data-index="{{index}}" size="40" data-regit="{{item.ifRegit}}"></icon>
                </view>
            </scroll-view>

            <view class="part-right">
                <view class="thumb">
                    <view class="num">{{scanData.length?scanData.length:0}}</view>
                    <view>已扫数量</view>
                </view>
                <view class="thumb" wx:for="{{ btnScan }}" wx:key='' bindtap="{{item.bindtap}}" data-ifcontinue="{{item.ifContinue}}">
                    <image src="{{'../../../../images/'+ item.img}}"></image>
                    <view>{{item.name}}</view>
                </view>
            </view>
        </view>

    </form>
</view>

<modal title="问题件登记" show="{{showModal}}" height='auto' bindconfirm='modalConfirm' bindcancel='modalCancel' showModal>
    <view class="modal-cancel" hidden="{{!abnormal.length}}">
        <view class="modal-cancel">
            <view class="abnormal" wx:for="{{abnormal}}" wx:key="" data-text="{{item.text}}" bindtap="abnormalSelect" style="{{item.text == abSelect.content?'color:red;boder:red':'color:grey;boder:grey'}}">{{item.text}}</view>
        </view>
        <attach recordCode="{{abRecordId}}" bindaddattach="addProof" list="{{_thumbURLS}}" binddelattach="delattach" scrollx="true" itemId="{{abSelect.itemId}}" />
    </view>
</modal>

<modal title="是否新建班次号" show="{{showModalTask}}" height='auto' bindconfirm='modalConfirmTask' bindcancel='modalCancel' showModal>
    <view class="modal-cancel">
        <!-- <view class="modal-cancel"> -->
        <field title="班次号" name="createtask" bindchange="getValue" data-field="task" value="{{select.task}}" placeholder="若不填则默认生成">
            <icon type="i-scan" size="40" bindtap="scanTask" data-field="task"></icon>
        </field>
        <attach recordCode="{{task.tbId}}" bindaddattach="addProof" list="{{task._thumbURLS}}" binddelattach="delattach" scrollx="true" itemId="{{tempid}}" />
    </view>
</modal>

<modal title="选择站点" show="{{showSite}}" height='auto' bindconfirm='modalConfirmSite' bindcancel='modalCancel' showModal>
    <view class="modal-cancel" hidden="{{!site.length}}">
        <view class="site" wx:for="{{site}}" wx:key="" data-text="{{item}}" bindtap="siteSelect" style="{{item.name == currentStation.name?'color:red;boder:red':'color:grey;boder:grey'}}">{{item.name}}</view>
    </view>
</modal>
<modal title="选择下一站站点" show="{{showNextSite}}" height='auto' bindconfirm='modalConfirmNextSite' bindcancel='modalNextCancel' showModal>
    <view class="modal-cancel" hidden="{{!site.length}}">
        <view class="site" wx:for="{{site}}" wx:key="" data-text="{{item}}" bindtap="nextSiteSelect" style="{{item.name == currentNextStation.name?'color:red;boder:red':'color:grey;boder:grey'}}">{{item.name}}</view>
    </view>
</modal>

<modal title="选择客户" show="{{showCustomer}}" height='auto' bindconfirm='modalConfirmCustomer' bindcancel='modalCancel' showModal>
    <view class="modal-cancel" hidden="{{!customer.length}}">
        <view class="site" wx:for="{{customer}}" wx:key="" data-text="{{item}}" bindtap="customerSelect" style="{{item.name == select.customer?'color:red;boder:red':'color:grey;boder:grey'}}">{{item.name}}</view>
    </view>
</modal>

<modal title="客户要求留仓" show="{{showFrozen}}" height='auto' bindconfirm='modalConfirmFrozen' bindcancel='modalCancel' showModal>
    <view class="modal-cancel" hidden="{{!frozen.length}}">
        <view class='frozen' style="{{item.ifHand? 'color:grey;':'color:red;'}}" wx:for="{{frozen}}" wx:key="" data-index="{{index}}" bindtap="frozenHand">{{item.code}}</view>
    </view>
</modal>