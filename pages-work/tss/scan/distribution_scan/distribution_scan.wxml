    <field title="{{select.field}}" name="{{select.field_code}}" bindchange="getValue" data-field="{{select.field_code}}" value="{{select[select.field_code]}}">
      <icon wx:if="{{select.needScan}}" type="i-scan" size="40" bindtap="scanTask" data-field="{{select.field_code}}"></icon>
    </field>
    </view> -->

