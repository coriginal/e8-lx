.formview {  
  background: #f1f3f5;
}
.tableview{
  padding-bottom: 55px;
}
.hideicontab{
  padding-bottom:5px;
} 

.header, .footer {
  padding-left: 32rpx;
  padding-right: 32rpx;
  font-size: 28rpx;
  color: #888;
}

.header {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.header::before, .header::after {
  content: '';
  display: table;
}

.footer {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

/* .footer::before, .footer::after {
  content: '';
  display: table;
} */

.cell {
  position: relative; 
  background: #fff;
  padding: 10rpx 32rpx;
  border-bottom: 2rpx solid #dbdbdb;
  box-sizing: border-box;
}

.first-cell {
  border-top: 2rpx solid #dbdbdb;
}

.draft-btn,.submit-btn {
  margin: 20rpx 16rpx 20rpx 16rpx;
} 

.value{
  flex:1;
  line-height:1.6;
  padding:4px 0;
  min-height:22px;
  height:auto;
  font-size:14px; 
}

.label,.pickerlabel{
  color:#333;
  min-width:60px;
  padding-right:15px;  
  font-size:14px; 
  display:inline-block;
}
.label{
  text-align:right;
}
.cell .label {
  font-size: 30rpx; color: #9b9b9b;
}

.cell .value {
  font-size: 30rpx; color: #35383c;
}
.status {
  position: absolute;
  top: 10rpx; right: 60rpx;
} 
.picker{
  background-color:#fff;
  padding:10px 7px 10px 15px;
} 
.line{
  position:relative;
}
.picker:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}

.right_arrow {
  width: 36rpx; 
  height: 36rpx;
} 
.nodata{
  padding: 20rpx 50rpx;
  color:#888;
  font-size:28rpx;
  background-color:#fff;
}
.accessory {
  position: absolute;
  top: 0; bottom: 0; right: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.accessory image {
  width: 36rpx; height: 36rpx;
}

.required:after{
  content:' *';
  color:red;
  display:inline; 
}
button[type=primary].draft-btn {
  background-color:#cdcdcd;
}
.datetimeview{
  background-color:#fff;
  padding:10px 7px 10px 15px;
  /* border-bottom:1px solid #e5e5e5; */
}
.datetimeview:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}
.datetime{
  display:inline-block;
}
.gl{
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}
.box{
  display: flex;
  flex-direction:row;
  flex-wrap:wrap;
  justify-content: flex-start;
  align-items:flex-start;
  align-content: flex-start;
  background-color: #fff;
  padding:10px 0;
}

.truck_cell{
  display:flex;
  width:33%;
  box-sizing:border-box;
  flex-direction: row;
  flex-wrap:wrap;
  justify-content:space-around;
  align-items:center;
  align-content:space-around;
  padding:5px 0;
}

.cell_item{
  width:80%;
  height:100%;
  padding:5px 0;
  text-align: center;
  border:2rpx solid #eee;
  font-size:14px;
  color:#8e8e8e;
}
.select_item{
  background-color:#fef8ea;
  color:#dca867;
}
.maskLayer {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.2;
  overflow: hidden;
  z-index: 1000;
  color: #fff;
}

.choose {
  width: 100%;
  overflow: hidden;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background: #fff;
  padding-top: 20rpx;
}
.btn_view{
  display:flex;
}
.draft-btn{
  width:40%;
}
.two_btn{
  width:60%;
}

.fieldClass:after{
  content:'';
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}
.cellClass:after{
  content:'';
  left:0!important;
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}
.searchBar{
    width: 100%;
    height: 76rpx;
    padding: 0rpx 20rpx;
    background:white;
    border-bottom: 1px solid whitesmoke;
    display: flex;
    align-items: center;
}
.searchBar input{
    background: whitesmoke;
    height: 50rpx;
    width: 80%;
    border-radius: 25rpx;
    padding:0 20rpx;
}
.searchBar button{
    height: 50rpx;
    font-size: 28rpx;
    line-height: 50rpx;
}