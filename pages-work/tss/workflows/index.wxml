<view class='box'>
    <view class="cell {{ (index+1) % 3 ===0 ? 'right' : ''}}" wx:for="{{ tableList }}" wx:key="{{item}}" style="height:{{ cellHeight }}" catchtap='openWorkflow' data-recordid="{{ item.id}}" data-wfingCount="{{ item.wfingCount }}" data-wxurl="{{ item.wxurl }}">
        <view>
            <view class="badge" wx:if="{{ item.wfingCount }}">
                <badge>{{ item.wfingCount }}</badge>
            </view>
            <image class='image' wx:if="{{ item.wxicon }}" src="{{ app_host + item.wxicon }}" style="height:{{imageHeight}};width:{{imageHeight}}">
            </image>
        </view>
        <view class='text'>
            <text>{{item.name}}</text>
        </view>
    </view>
</view>