.wrap{
  background-color:#fff;
}
.actions {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  padding:20rpx 0;
}

.actions button {
  flex: 1;
  margin: 0 16rpx;
  font-size:15px;
}
.refuse{
  background-color:#eee; 
}
.title{
  padding:10rpx 0 0 30rpx;
  font-weight:bold;
}
.footer{
  height:12px;
  background-color:#eee;
}

.node{
  position: relative;
  padding-left: 40px;
} 

/* 全高设置 */
.node::before,.line::before{
  content: '';
  position: absolute; 
  background: #eaeaea;
}

/* 圆线定义 */
.node::before{
  font-weight:bold;
  width: 15px;
  height: 15px;
  border-radius: 50%; 
  left: 18px;
  top: 35%;
  font-size:30rpx;
  text-align:center;
  z-index:1;
  line-height:15px;
  color:#fff;
  background-color:#eee;
}
.node.pass::before{
  content:'✓'; 
  background-color:#224b9b;
}
.node.back::before{
  content:'!';
  background-color:#ff2d2d;
}
.line::before{
  width: 2px;
  height: 100%;  
  left: 24px;
} 

/* 半高设置 头尾定位*/
.line.head::before,.line.tail::before{
  height: 50%; 
}
.line.head::before{
  top: 50%;
}
line.tail::before{
  top: 0;
}

/* 只有一个节点时，线高0 */
.line.head.tail::before{
  height: 0; 
}
.copyto{
  font-size:14px;
  color:#c1c1c1;
  padding-left:50px;
  padding-bottom:10rpx;
}
.attach{
  margin-left:100rpx;
}
.required:after{
  content:' *';
  color:red;
  display:inline; 
}
.line{
  position:relative;
}
picker{
  background-color:#fff;
  padding:10px 7px 10px 15px;
} 
picker:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}
.label,.pickerlabel{
  color:#333;
  min-width:60px;
  padding-right:15px;  
  font-size:14px; 
  display:inline-block;
}
.value{
  flex:1;
  line-height:1.6;
  padding:4px 0;
  min-height:22px;
  height:auto;
  font-size:14px; 
}
.fieldClass:after{
  content:'';
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}
.notice{
  position:absolute;
  left:220rpx;
  height:50rpx;
  line-height:50rpx;
  font-size:30rpx;
  z-index:99;
}
.send_msg{
  position:absolute;
  left:420rpx;
  height:50rpx;
  line-height:50rpx;
  font-size:30rpx;
  z-index:99;
}
.urge{
  position:absolute;
  right:20rpx;
  height:60rpx;
  line-height:60rpx;
  font-size:30rpx;
  z-index:99;
  bottom:15rpx;
}
.modal-mask {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 9000;
  color: #fff;
}

.modal-dialog {
  width: 86vw;
  /* overflow: hidden; */
  position: fixed;
  top: 20vh;
  left: 7vw;
  z-index: 9999;
  background: #f9f9f9;
  border-radius: 36rpx;
}

.modal-title {
  padding-top: 10rpx;
  font-size: 36rpx;
  color: #030303;
  text-align: center;
}

.modal-content {
  padding: 20rpx;
}

.modal-input {
  display: flex;
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 4rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  flex-direction: row;
  height: 86rpx;
  border-top: 1px solid #dedede;
  font-size: 34rpx;
  line-height: 86rpx;
}

.btn-cancel {
  width: 50%;
  color: #666;
  text-align: center;
  border-right: 1px solid #dedede;
}

.btn-confirm {
  width: 50%;
  color: #ec5300;
  text-align: center;
}
.hidemodal{
  visibility:hidden;
}
.showmodal{
  visibility:visible;
}
.header {
  padding: 20rpx 32rpx 20rpx 32rpx;
  font-size: 28rpx;
  color: #888;
}

.header::before, .header::after {
  content: '';
  display: table;
}

.box{
  display: flex;
  flex-direction:row;
  flex-wrap:wrap;
  justify-content: flex-start;
  align-items:flex-start;
  align-content: flex-start;
  background-color: #fff;
  padding:10px 0;
}
.box_title{
  padding-top:15px;
  padding-left:5px;
  font-size:17px;
  color:#535353;
}
.people_cell{
  display:flex;
  width:25%;
  box-sizing:border-box;
  flex-direction: row;
  flex-wrap:wrap;
  justify-content:space-around;
  align-items:center;
  align-content:space-around;
  padding:5px 0;
}
.cell_item{
  width:80%;
  height:100%;
  padding:5px 0;
  text-align: center;
  border:2rpx solid #eee;
  font-size:14px;
  color:#8e8e8e;
}
.select_item{
  background-color:#fef8ea;
  color:#dca867;
}