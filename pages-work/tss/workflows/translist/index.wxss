.fieldClass:after{
  content:'';
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}
.search-form {
  background: #f5f5f5;
  line-height: 64rpx;
  height: 64rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  border-radius: 10rpx;
}

.search-form view {
  margin: 0 15rpx;
}

.search-form input {
  flex: 1;
  padding-right: 20rpx;
  font-size: 26rpx;
}