.receive_city {
  font-weight: bold;
  font-size: 60rpx;
}

.detail-page {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: white;
  border-radius: 10rpx;
  overflow: scroll;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 154rpx;
}

.top-ocode {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
  display: -webkit-flex;
}

.receive-panel {
  padding: 0 20rpx;
  border-right: 1px solid#eee;
}


.flex-1 {
  flex: 1;
}

.placeorder {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 13px;
}

.placeorder view {
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.placeorder-flex {
  display: flex;
  align-items: center;
  display: -webkit-flex;
  -webkit-align-items: center;
}

.solid-bottom>view {
  border-bottom: 1px solid#eee;
}

.text-flex-end {
  justify-content: flex-end;
  color: var(--red);
  font-weight: bold;
}

.color-red {
  color: var(--red);
  font-weight: bold;
}

.opcity {
  opacity: 0.7;
  font-size: 13px;
}

.placeorder-load {
  line-height: 48rpx;
  height: 48rpx;
}

.text-remark {
  padding: 0 20rpx;
  line-height: 64rpx;
}

.sub-orders {
  font-size: 40rpx;
  font-weight: bold;
  padding: 0 20rpx;
  margin: 15rpx 0;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 30rpx 0;
  background-color: white;
  /* z-index: 999; */
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
  flex: 1;
}

.confirm-btn {
  width: 80%;
  margin-top: 30rpx;
}

.content {
  display: flex;
  line-height: 48px;
  align-items: center;
}

.content .pop-input {
  flex: 1;
  padding: 0 20rpx;
  text-align: left;
}

.pop-placeorder {
  opacity: .7;
}

.text-send {
  opacity: .8 !important;
  color: var(--blue);
  font-weight: bold;
}

.text-receive {
  opacity: .8 !important;
  color: var(--red);
  font-weight: bold;
  
}
.wux-badge__count {
  top: -13px !important;
  right: -16px !important;
}
.my-quote{
  padding: 20rpx;
}