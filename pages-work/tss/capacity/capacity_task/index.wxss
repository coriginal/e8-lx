.panel {
  background-color: var(--white);
  /* margin: 25rpx 30rpx; */
  padding: 10rpx 20rpx;
  /* border: 1px solid var(--gray); */
  border-radius: 6rpx;
  box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  margin-top: 20rpx;
  min-height: 320rpx;
  position: relative;
}

.head {
  /* display: flex; */
  /* justify-content: space-between; */
  /* align-items: center; */
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eee;

}

.background-qiang {
  position: absolute;
  right: 10px;
  top: 110rpx;
  height: 48px;
  opacity: .7;
  width: 48px;
}

.left_head {
  display: flex;
  align-items: center;
  display: -webkit-flex;
  -webkit-align-items: center;
}

.status {
  position: absolute;
  right: 20px;
}

.likeicon {
  color: var(--blue);
  font-size: 16px;
}

.order-code {
  font-size: 11px;
}

.table_title {
  margin-right: 16rpx;
}

.table_content {
  font-size: 17px;
}

/* .status {
  margin: auto 0;
} */

.task-row {
  line-height: 56rpx;
}

.line_info {
  display: flex;
  justify-content: space-evenly;
  line-height: 48rpx;
  display: -webkit-flex;
  -webkit-justify-content: space-evenly;
}

.flex-1 {
  flex: 1;
  text-align: left;
}

.foot_menu {
  padding: 10rpx 6rpx;
  border-top: 1px solid#eee;
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  display: -webkit-flex;
  -webkit-justify-content: space-between;
}

.btn {
  margin: 0;
}

.btn-change {
  background-color: transparent;
  color: var(--blue);
}

.task-content {
  padding: 0 20rpx;
}

.depart {
  bottom: 10rpx;
  padding: 0;
  line-height: 70rpx;
  height: 70rpx;
  width: 33.333333%;
  margin: 0;
  border-radius: 2px;
}

.view-btn {
  display: flex;
  justify-content: flex-end;
  display: -webkit-flex;
  -webkit-justify-content: flex-end;
}

.text-area {
  margin-right: 16rpx;
  font-size: 18px;
  color: #444 !important;
}

.left_head .wux-tag {
  height: 54rpx;
  font-size: 15px;
  width: 64rpx;
}

.text-truck-type {
  margin: 0 16rpx;
  color: #444;
  font-size: 18px;
  overflow: hidden;
  height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 60px;
}

.nothing {
  text-align: center;
  color: gray;
  line-height: 280px;
}



/* popup */

.pop-title {
  font-size: 17px;
  color: #444;
}

.pop-textarea-panel {
  margin-top: 20rpx;
  border: 1px solid#eee;
  padding: 20rpx;
  border-radius: 10rpx;
}

.pop-textarea {
  text-align: left;
  font-size: 12px;
  width: 100%;
}

.pop-date-choose {
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  font-size: 14px;
}

.pop-date-choose .value {
  text-align: right;
  flex: 1;
}

.popup-flex {
  display: flex;
  padding-top: 20rpx;
}

.popup-flex .btn:first-child {
  margin-right: 15rpx;
}

.pop-locationfill {
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 13px;
}

.router-pop-auto {
  padding: 15rpx 20rpx;
  text-align: left;
  border: 1rpx solid#eee;
  margin: 30rpx 0;
  display: flex;
  align-items: center;
  height: 74rpx;
  color: #444;
  border-radius: 6rpx;
  transition: all .3s;
}

.choose-auto {
  border-color: var(--blue);
}

.auto-route-input {
  background-color: #eee;
  text-align: center;
  flex: 1;
  margin: 0 10rpx;
  display: flex;
  align-items: center;
  width: 50%;
}

.more-textarea {
  text-align: left;
  padding: 10rpx 20rpx;
  color: var(--blue);
}

textarea {
  height: 64px;
}

.pop-choose {
  /* color: #5a6b92; */
  padding-left: 20rpx;
  display: flex;
  align-items: center;
  width: 64px;
}

.text-blue {
  color: var(--blue);
}

.pop-choose view {
  padding-right: 8rpx;
}


.flex-2 {
  flex: 2;
}

.checkbox-group-view {
  display: flex;
  text-align: center;
  align-items: center;
  padding-bottom: 15rpx;
}

.checkbox-group-view checkbox {
  transform: scale(.8);
  width: 100%;
}

.padding {
  padding: 15rpx;
}

.all-choose {
  flex: 0.5 !important;
}

.wux-badge__count {
  top: -24rpx !important;
  right: -10rpx !important;
}

.message-again {
  display: flex;
  justify-content: space-between;
}

._setting {
  color: blue;
  background: #fff;
}

.icon-right {
  float: right;
}
