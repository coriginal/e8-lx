  .bottom-btn {
    position: fixed;
    bottom: 0;
    padding: 20rpx 30rpx;
    background-color: white;
    left: 0;
    right: 0;
    z-index: 500;
  }

  .solid-blue::after {
    border-color: var(--blue) !important;
  }

  .bottom-btn .btn {
    width: 100%;
    border-radius: 1000rpx;
  }

  .panel-title {
    font-weight: bold;
    padding: 30rpx 0;
    margin: 0 30rpx;
  }

  .upload-img {
    position: relative;
    width: 548rpx;
    max-height: 340rpx;
  }

  .bg-img {
    position: relative;
    width: 548rpx;
    height: auto;
  }

  .bg-img .card-img::after {
    color: #666666;
    position: absolute;
    transform: translate(-10%);
    margin-top: 30rpx;
    white-space: nowrap;
    font-size: 13px;
  }

  .bg-img .card1::after {
    content: "上传行驶证";
  }

  .bg-img .card2::after {
    content: "上传车辆照片";
  }

  .bg-img .photo-img {
    position: absolute;
    width: 110rpx;
    height: auto;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    overflow: visible;
  }

  .input-view {
    height: 64rpx;
  }

  .ml-30 {
    margin-left: 30rpx;
  }

  .mr-30 {
    margin-right: 30rpx;
  }

  .flex {
    display: flex;
    align-items: center;
  }

  .flex-1 {
    flex: 1
  }

  .mt-20 {
    margin-top: 20rpx;
  }

  .pb-10 {
    padding-bottom: 10rpx;
  }

  .p-20 {
    padding: 20rpx;
  }

  .truck-type {
    display: flex;
    flex-wrap: wrap;
  }

  .panel {
    margin: 20rpx;
    padding: 10rpx;
    white-space: nowrap;
  }

  .panel-view {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20rpx 10rpx;
    padding: 5rpx;
    flex-direction: column;
    background-color: white;
  }

  .bg-white {
    background-color: white;
  }

  .top-list{
    line-height: 64rpx;
    padding: 0 20rpx;
  }