.wux-badge__count {
  top: -13px !important;
  right: -16px !important;
}

.list {
  padding: 0 20rpx;
}

.flex-1 {
  flex: 1;
}

.list .panel {
  padding: 10rpx 20rpx;
  background-color: white;
  border-radius: 6rpx;
  margin-top: 15rpx;
  font-size: 26rpx;

}

.panel .head {
  display: flex;
  align-items: center;
  line-height: 48rpx;
  /* border-bottom: 2rpx solid #eee; */
}

.head .detail {
  color: #5a6b92;
}

.panel .content {
  /* border-bottom: 1px solid #eee; */
  margin-top: 10rpx;
}

.content .city {
  min-height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}


.content-left,
.content-right {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 50%;
  text-align: left;
}

.content-center image {
  width: 48rpx;
  height: auto;
}

.opcity {
  opacity: .7;
}

.t-f32 {
  font-size: 36rpx;
  margin: 0 20rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

.text-center {
  margin: 0 20rpx;
}

.center-view {
  display: flex;
  align-items: center;
}

.panel .foot {
  font-size: 24rpx;
  line-height: 64rpx;
  color: grey;
  text-align: right;
}

.shadow {
  box-shadow: var(--shadowSize) var(--blackShadow);
}

.margin-text {
  margin: 0 10rpx;
  font-weight: bold;
  font-size: 16px;
}

.slot-view {
  padding: 0 20rpx;
  color: #444;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.slot-view view {
  height: 48rpx;
  line-height: 48rpx;
}

.cargo-info {
  padding: 0 20rpx;
  line-height: 48rpx;
}
.display-block{
  display: block;
}

.share{
  text-align: right;
}
.share .btn{
  width: 164rpx;
}