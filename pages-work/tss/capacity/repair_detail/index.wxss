/* pages-work/tss/capacity/repair_detail/index.wxss */
.container {
    width: 100%;
    padding-bottom: 120rpx;
}

.container .title {
    width: 100%;
    padding-left: 30rpx;
    height: 80rpx;
    line-height: 80rpx;
    background: whitesmoke;
    position: fixed;
    top: 0;
    font-size: 38rpx;
    font-weight: 600;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.title image {
    display: inline-block;
    width: 30rpx;
    height: 30rpx;
    margin-left: 10rpx;
}

.container .detail_box {
    width: 93%;
    border-radius: 20rpx;
    margin: 0 auto;
    background: white;
    padding: 20rpx;
    margin-bottom: 20rpx;
}

.detail_box>view {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    line-height: 48rpx;
}

.detail_box>view view:nth-child(1) {
    color: gray;
}

.detail_box>view view:last-child {
    width: 50%;
    text-align: right;
}
.repair_list_box,.feedback_box{
    width: 96%;
    background: white;
    margin: 0 auto;
    padding: 20rpx;
    box-sizing: border-box;
}
.feedback_box{
    margin-bottom: 20rpx;
}
.repair_list_box_title,.feedback_box {
    font-size: 30rpx;
    font-weight: bold;
}

.goods {
    padding: 20rpx;
    border-bottom: 1rpx dashed gray;
}

.goods>view:nth-child(1) {
    font-size: 30rpx;
}

.goods view:nth-child(2) {
    width: 100%;
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    color: gray;
}
.repair_list_box .goods:last-child{
    border: none;
}
.feedback_content{
    font-size: 25rpx;
    font-weight: normal;
    display: flex;
    flex-direction: column;
}
.feedback_content>view{
    line-height: 45rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}
.feedback_content>view view:nth-child(2){
    width: 50%;
    word-break: break-all;
    text-align: right;
}
.feedback_content>view:nth-child(2) view:nth-child(2){
    text-align:left;
}
.feedback_list{
    margin: 20rpx auto;
    background: whitesmoke;
    padding: 10rpx;
}
.feedback_img{
    font-size: 28rpx;
    margin: 10rpx 0;
}
.img_box{
    margin-top: 20rpx;
    overflow: auto;
    white-space: nowrap;
}
.img_box image{
    height: 300rpx;
    width: 300rpx;
}
.bottom_button{
    width: 100%;
    height: 100rpx;
    position: fixed;
    bottom: 0;
    display: flex;
    flex-direction: row;
}
.bottom_button>view{
    flex: 1;
    text-align: center;
    line-height: 100rpx;
}
.repair_list_box_title{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}
.repair_list_box_title>view:nth-child(2){
    font-size: 28rpx;
}
.feedback_page{
    max-height: 800rpx;
    padding: 30rpx;
    padding-bottom: 100rpx;
    overflow: auto;
}
.feedback_page_title{
    width: 100%;
    text-align: center;
    font-weight: bold;
}
.feedback_page_list{
    padding: 30rpx;
    display: flex;
    flex-direction: column;
}
.feedback_page_list>view{
    display: flex;
    flex-flow: row;
    justify-content: space-between;
    margin:10rpx 0;
}
.feedback_page_list>view textarea{
    height: 200rpx;
    flex:1;
    margin-left:30rpx;
    background:whitesmoke;
    margin-top: 10rpx;
}
.feedback_page_list>view:last-child{
    display: flex;
    flex-direction: column;
}
.feedback_page_list>view image{
    margin: 20rpx;
    width: 158rpx;
    height: 158rpx;
    display: inline-block;
    flex-shrink: 0;
}
.feedback_page_list>view:last-child view:nth-child(2){
    background: whitesmoke;
    margin-top: 20rpx;
}
.feedback_up_button{
    position: fixed;
    bottom: 0;
    margin-bottom: 30rpx;
    width:calc(100% - 60rpx);
    height: 80rpx;
    border-radius: 20rpx;
    text-align: center;
    line-height: 80rpx;
}
.img{
    position: relative;
}
.delimg{
    width: 50rpx !important;
    height: 50rpx !important;
    position: absolute;
    top: -20rpx;
    right: -20rpx;
}
.subscribe_box{
    height: 500rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx;
}
.subscribe_title{
    font-size: 35rpx;
    font-weight: bold;
}
.subscribe_items{
    width: 100%;
}
.subscribe_items>view{
    line-height: 80rpx;
    padding: 0 30rpx;
    font-size: large;
    border: 5rpx solid var(--blue);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 30rpx;
    border-radius: 45rpx;
}
.subscribe_button{
    text-align: center;
    line-height: 80rpx;
    height: 80rpx;
    width: 90%;
    border-radius: 45rpx;
    margin: 50rpx;
}