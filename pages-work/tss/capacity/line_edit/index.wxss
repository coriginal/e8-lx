.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* Form section - using .addr and .bar pattern from customer_addr_edit */
.addr {
  padding: 0 20rpx;
  margin: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
}

.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
  position: relative;
}

.bar input {
  flex: 1;
  height: 100rpx;
  font-size: 28rpx;
  color: #333;
}

.bar picker {
  flex: 1;
}

.bar .title {
  padding-right: 30rpx;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
}

.bar .title.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 4rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #333;
  display: inline;
}

.picker-value.placeholder {
  color: #ccc;
}

.picker-value.placeholder {
  color: #ccc;
}

/* Belong name selector */
.belong-name-selector {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 100rpx;
}

.belong-name-selector .picker-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.belong-name-selector .picker-value.placeholder {
  color: #ccc;
}

/* Cards section */
.cards-section {
  padding: 0 20rpx;
}

.location-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx 20rpx;
  margin-bottom: 0;
  position: relative;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 10rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.card-item:last-child {
  border-bottom: none;
}

.card-item .label {
  width: 150rpx;
}

.card-item .input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 60rpx;
  line-height: 60rpx;
}

/* Site selector */
.site-selector {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}

.site-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.site-value.placeholder {
  color: #ccc;
}

/* Region selector */
.region-selector {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}

.region-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.region-value.placeholder {
  color: #ccc;
}

/* Add node button */
.add-node-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin: 8rpx 0;
  position: relative;
}

.add-node-btn::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 100%;
  background-color: #d9d9d9;
  z-index: 0;
}

.add-node-btn icon {
  background: #f5f5f5;
  z-index: 1;
  padding: 4rpx;
  border-radius: 50%;
}

/* Site search popup */
.site-search-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 70vh;
}

.site-search-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.site-search-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.site-search-input {
  background: #f5f5f5;
  border-radius: 8rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.site-search-list {
  max-height: 500rpx;
}

.site-result-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.site-result-item:active {
  background-color: #f5f5f5;
}

.site-result-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.site-result-addr {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.search-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.search-nomore {
  text-align: center;
  padding: 20rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

/* Save button */
.save-area {
  padding: 40rpx 20rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3c9cff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  text-align: center;
}

.save-btn:active {
  opacity: 0.8;
}
