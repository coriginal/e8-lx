.container{
    width: 100%;
    padding: 5rpx 20rpx;
    background: whitesmoke;
}
.box{
    width: 100%;
    margin: 20rpx 0;
    min-height: 300rpx;
    background: white;
    border-radius:20rpx;
    box-shadow:0 2rpx 6rpx gray;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.box .bar{
    height: 50rpx;
    line-height: 50rpx;
    background: gray;
    color: white;
    display: flex;
    padding: 0 20rpx;
    justify-content: space-between;
    font-weight: bold;
}
.content{
    height: auto;
    padding:20rpx 40rpx;
    display: flex;
    justify-content: center;
    flex-direction: column;
    font-size: 25rpx;
}
.content view:nth-child(1){
    font-weight: bold;
}
.footer{
    width: 100%;
    height: 70rpx;
    display: flex;
    align-items: center;
    border-top: 1rpx dashed gray;
}
.footer view{
    display: inline-block;
    position: absolute;
    width: 100rpx;
    height: 45rpx;
    border-radius: 10rpx;
    text-align: center;
    line-height: 45rpx;
}
.footer view:nth-child(1){
    right: 160rpx;
}
.footer view:nth-child(2){
    right: 40rpx;
}
.footer view:nth-child(3){
    width: 150rpx;
    right: 280rpx;
}
.footer view:active{
    opacity: 0.6;
}
.footer view:last-child{
    left: 40rpx;
    width:112rpx;
    font-size:26rpx;
}
.isAll{
    width: 100%;
    text-align: center;
    margin-bottom: 20rpx;
    color: gray;
}
.isAll span{
    border-bottom: 1rpx solid var(--blue);
}