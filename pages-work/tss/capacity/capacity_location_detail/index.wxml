<location></location>
<view>
    <view class="top_line">
        <view wx:if="{{task_type != '中转'}}" wx:for='{{typeObj[type].top_btn}}' wx:for-index="key" class="{{item.class}} top_view" bindtap="{{item.bindtap}}" wx:key hover-class="default" hover-stay-time="500" data-check="{{showCheck}}">
            <icon type="{{item.icon}}" size="40" wx:if="{{item.icon}}"></icon>
            <text wx:if="{{item.useIfList}}">{{if_list ? '地图模式' : '列表模式'}}</text>
            <text wx:if="{{!item.useIfList}}">{{key == '批量操作' && showCheck?'取消操作':key}}</text>
            <switch checked="{{show_done}}" class="top-switch blue" color="blue" wx:if="{{item.type == 'switch'}}"></switch>
        </view>
    </view>

    <view wx:if="{{if_list}}" class="middle_body">
        <view class="flex_view" wx:for="{{showData}}" wx:for-item="order" wx:key>
            <view class='panel t-f32 {{order.selected}}' bindtap="goOrderDetail" data-id="{{order.order_id}}" data-code="{{order.code}}">
                <view class='head'>
                    <view class="left_head">
                        <view>
                            <view class="status start-end">
                                <view>
                                    <text class="text-blue">{{order.title}}</text>
                                    <!-- <text data-order_id="{{order.id}}" catchtap="goDetail">查看详情</text> -->
                                </view>
                            </view>
                            <tag wx:if="{{order.tag}}" color='red'>{{order.tag}}</tag>
                        </view>
                        <view class="order-code text-gray ">订单号：{{order.show_code}}</view>
                    </view>
                    <view class="check" hidden="{{!showCheck}}">
                        <!-- <text>{{order.status}}</text> -->
                        <checkbox color="#5c96ec" class="radio" checked="{{order.selected}}" value="{{item.title}}" catchtap="switchChange" data-id="{{order.id}}"></checkbox>
                    </view>
                </view>
                <view class="addr_info">
                    <view class="flex_view">
                        <image class="addr_pic" src="{{typeObj[location_type].addr_pic}}"></image>
                        <view>
                            <view class="flex-1">{{order.receive_man}}</view>
                            <view class="flex-1">{{order[typeObj[location_type].addr_col]}}</view>
                        </view>
                    </view>
                </view>

                <view class="content-foot flex align-center">
                    <view class="status">
                        <view class="title">客户</view>
                        <view class="value">{{order.customer_name||''}}</view>
                        <view wx:if="{{order.ccode}}" class="value text-grey">{{order.ccode||''}}</view>
                    </view>

                    <view class="status solid-left solid-right">
                        <view class="title">货物信息</view>
                        <view class="value">
                            <text wx:if="{{order.amount>0}}">{{order.amount}}件 </text>
                            <text wx:if="{{order.weight>0}}">{{order.weight}}kg </text>
                            <text wx:if="{{order.volume>0}}">{{order.volume}}m³ </text>
                        </view>
                    </view>

                    <view class="status">
                        <view class="title">状态</view>
                        <view class="text-orange value">{{order.status||''}}</view>
                    </view>
                </view>

                <view>
                    <block wx:for='{{flexTagObj[type]}}' wx:for-index="key" wx:key>
                        <tag wx:if="{{order[key] && (order[key] == item.value || !item.value)}}" color="{{item.color}}">{{item.title}}</tag>
                    </block>
                </view>

                <view class="flex_view flex-between">
                    <abnormal udf_btn_class="a_btn" type="order" task_id="{{task_id}}" order_id="{{order.id}}" task_type="{{task_type}}" recordid="-8" bindreport="reportAbnormal"></abnormal>
                    <pick_sign wx:if="{{task_type != '中转' && !order.if_done}}" task_id="{{task_id}}" sub_order_ids="{{order.id}}" order_ids="{{order.order_id}}" type="{{location_type}}" volume="{{order.volume}}" weight="{{order.weight}}" amount="{{order.amount}}" num="1" rcode_type="{{order.rcode_type}}" bindpick="pickSignDone" bindsign="pickSignDone"></pick_sign>
                    <!-- <button wx:if="{{task_type != '中转' && !order.if_done}}" class="btn bg-blue" bindtap="showPickSign" data-sorder_id="{{order.id}}" data-rcode_type="{{order.rcode_type}}" data-volume="{{order.volume}}" data-weight="{{order.weight}}" data-amount="{{order.amount}}">{{type == 'start' ? '确认取件' : '签 收'}}</button> -->
                </view>

            </view>

        </view>
    </view>
    <view style="height:1px"></view>
    <view wx:if="{{!if_list}}">
        <map id="map" longitude="{{lng}}" latitude="{{lat}}" scale="14" data-id="{{item.id}}" markers="{{markers}}" bindmarkertap="goDetail" bindcallouttap="goDetail" show-location style="width: 100%; height: 100vh;"></map>
    </view>
    <view wx:if="{{if_list}}" class="flex_view bottom_btn">
        <view hidden="{{showCheck}}" wx:for='{{typeObj[task_type].bottom_btn}}' wx:for-index="key" wx:key class="{{item.class}}" bindtap="{{item.bindtap}}">{{key}}</view>
        <view hidden="{{!showCheck}}" wx:for='{{typeObj[task_type].batch_btn}}' wx:for-index="key" wx:key class="{{item.class}}" wx:if="{{(item.if_op||if_op)== if_op}}" bindtap="{{item.bindtap}}">{{key}}</view>
    </view>

</view>



<wxs module="fn">
    module.exports = {
        unit: function (value) {
            switch (value) {
                case 'amount':
                    return '件';
                    break;
                case 'volume':
                    return 'm³';
                    break;
                case 'weight':
                    return 'kg';
                    break;
            }
        }
    }
</wxs>