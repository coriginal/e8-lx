page {
font-size: 14px;
color: #333;
}
.container{
  overflow-x: scroll;
  width: 100%;
}
.total{
  float:right;
  font-style:italic;
  line-height:2.3;
}
.table {
border:1px solid #dadada;
border-right: 0;
border-bottom: 0;
}
.tr {
width: 100%;
display: flex;
justify-content: space-between;
}
.th,.td {
padding: 5px;
border-bottom: 1px solid #dadada;
border-right: 1px solid #dadada;
background-color: white;
text-align: center;
width:100%;
word-break:break-all;
}
.th {
font-weight: 400;
background-color: #dadada
}
.value{
  flex:1;
  line-height:1.6;
  padding:4px 0;
  min-height:22px;
  height:auto;
  font-size:14px; 
  color: #333;
} 

.label,.pickerlabel{
  color:#333;
  min-width:60px;
  padding-right:15px;  
  font-size:14px; 
  display:inline-block;
}
.label{
  text-align:right;
}

.status {
  position: absolute;
  top: 10rpx; right: 60rpx;
} 
.line{
  position:relative;
}
picker{
  background-color:#fff;
  padding:10px 7px 10px 15px;
} 
picker:after{
  content:'';
  position:absolute;
  top:0;
  width:200%;
  height:200%;
  -webkit-transform:scale(.5);
  transform:scale(.5);
  -webkit-transform-origin:0 0;
  transform-origin:0 0;
  pointer-events:none;
  box-sizing:border-box;
  border:0 solid #e5e5e5;
  border-top-width:1px;
  left:0;
  right:0
}

.required:after{
  content:' *';
  color:red;
  display:inline; 
}

.datetimeview{
  background-color:#fff;
  padding:10px 7px 10px 15px;
  border-bottom:1px solid #e5e5e5;
}
.datetime{
  display:inline-block;
}
.queryparam{
  padding:10rpx;
  height:30px;
}

button{
  overflow: visible;
}

.modal-mask {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: #000;
  opacity: 0.5;
  overflow: hidden;
  z-index: 9000;
  color: #fff;
}

.modal-dialog {
  width: 86vw;
  /* overflow: hidden; */
  position: fixed;
  top: 20vh;
  left: 7vw;
  z-index: 9999;
  background: #f9f9f9;
  border-radius: 36rpx;
}

.modal-title {
  padding-top: 10rpx;
  font-size: 36rpx;
  color: #030303;
  text-align: center;
}

.modal-content {
  padding: 20rpx;
}

.modal-input {
  display: flex;
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 4rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  flex-direction: row;
  height: 86rpx;
  border-top: 1px solid #dedede;
  font-size: 34rpx;
  line-height: 86rpx;
}

.btn-cancel {
  width: 50%;
  color: #666;
  text-align: center;
  border-right: 1px solid #dedede;
}

.btn-confirm {
  width: 50%;
  color: #ec5300;
  text-align: center;
}
.hidemodal{
  visibility:hidden;
}
.showmodal{
  visibility:visible;
}
.fieldClass:after{
  content:'';
  border:0px solid #e5e5e5!important;
  border-top-width:1px!important;
  border-bottom-width:0!important;
}