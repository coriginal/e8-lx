.flex {
  display: flex;
}

.text-red {
  color: var(--red);
}

.text-bold {
  font-weight: bold;
}

.cu-timeline .cu-time {
  width: 96rpx;
  text-align: right;
  padding: 30rpx 0;
  display: block;
  line-height: 1.6;
}

.cu-timeline>.cu-item {
  flex: 1;
  padding: 10rpx 20rpx 0 50rpx;
  position: relative;
  display: block;
  z-index: 0;
}

.cu-capsule {
  display: inline-flex;
  vertical-align: middle;
  align-items: center;
  opacity: 0.8;
}

.cu-timeline>.cu-item::before {
  content: "";
  border-radius: 5000rpx;
  position: absolute;
  top: 50rpx;
  z-index: 9;
  background-color: var(--gray);
  width: 10px;
  height: 10px;
  left: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cu-timeline>.cu-item::after {
  content: "";
  display: block;
  position: absolute;
  width: 1px;
  background-color: #eee;
  left: 15px;
  height: 100%;
  top: 0;
  z-index: 8;
}

.margin-left-sm {
  margin-left: 10rpx;
}

.cu-timeline>.cu-item>.content {
  padding: 20rpx 0 20rpx 20rpx;
}

.time-date {
  font-size: 24rpx !important;
  white-space: nowrap;
}

.time-times {
  font-size: 22rpx !important;
  opacity: 0.7;
}
