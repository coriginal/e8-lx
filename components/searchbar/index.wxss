.cu-bar {
  display: flex;
  position: relative;
  align-items: center;
  background: #fff;
  height: 100rpx;
  justify-content: space-between;
  width: 100%;
}

.search-form view{
  padding: 0 15rpx;
}

.action{
  padding-right: 20rpx;
  font-size: 26rpx;
}
.action view{
  border-radius: 6rpx;
  font-size: 26rpx;
  padding: 10rpx;
  border: 2rpx solid var(--blue);
  color: var(--blue);
}
.cu-bar .search-form {
  background: #f5f5f5;
  line-height: 64rpx;
  height: 64rpx;
  font-size: 24rpx;
  flex: 1;
  display: flex;
  align-items: center;
  margin: 0 20rpx;
  border-radius: 4px;
}

.cu-bar .search-form input {
  flex: 1;
  font-size: 26rpx;
}

.btn {
  border-radius: 6rpx;
}

.right-scan {
  margin-right: 10rpx;
}
