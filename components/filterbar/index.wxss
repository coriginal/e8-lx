.wux-backdrop{background:rgba(0,0,0,.4)}.wux-filterbar{position:relative;z-index:1000}.wux-filterbar__bd{display:-ms-flexbox;display:flex;position:relative}.wux-filterbar__item{position:relative;display:block;-ms-flex:1;flex:1;padding:26rpx 0;text-align:center}.wux-filterbar__item--checked{color:var(--orange)}.wux-filterbar__select{position:absolute;top:100rpx;left:0;width:100%;background-color:#fff;box-sizing:border-box}.wux-filterbar__pop{height:100%;width:90%;overflow:hidden;position:fixed;top:0;left:10%;z-index:1010;background-color:#ffffff;box-sizing:border-box}.wux-filterbar__scroll-view{max-height:540rpx}.wux-filterbar__pop .wux-filterbar__scroll-view{max-height:none;height:calc(100% - 108rpx)}.wux-filterbar__panel{padding:0 30rpx}.wux-filterbar__panel:last-child{padding-bottom:40rpx}.wux-filterbar__panel-hd{height:92rpx;padding-top:40rpx;padding-bottom:4rpx;color:#252525;overflow-x:hidden;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center}.wux-filterbar__panel-selected{width:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;-ms-flex:1;flex:1;text-align:right;font-size:26rpx;line-height:48rpx;color:var(--red)}.wux-filterbar__groups{overflow:hidden;font-size:26rpx;margin:0 -10rpx}.wux-filterbar__group{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;position:relative;height:64rpx;width:33.3333%;color:#232326;margin-top:20rpx;float:left;box-sizing:border-box;padding-left:10rpx;padding-right:10rpx}.wux-filterbar__btn,.wux-filterbar__check,.wux-filterbar__radio{width:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;height:64rpx;display:block;text-align:center;line-height:64rpx;background-color:#f0f2f5;border-radius:10rpx;border:2rpx solid #f0f2f5;box-sizing:border-box}.wux-filterbar__check,.wux-filterbar__radio{position:absolute;left:10rpx;top:0;width:calc(100% - 20rpx);opacity:0}.wux-filterbar__btn--checked{border:2rpx solid var(--red);background-color:#fff;color:var(--red)}.wux-filterbar__btns{height:88rpx;display:-webkit-box;overflow:hidden;display: flex;align-items: center;justify-content: center;}.wux-filterbar__input{font-size: 26rpx;border-radius: 10rpx;padding: 10rpx;margin-top: 20rpx;background-color: #f0f2f5;}.m-p {margin: 0 20rpx;padding: 20rpx 32rpx;border-radius: 6rpx;height: 84rpx;font-weight: 500;}.flex-1{flex:1}.flex-4{flex:4}