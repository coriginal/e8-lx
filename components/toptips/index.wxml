<wux-animation-group wux-class="{{ classes.wrap }}" in="{{ in }}" classNames="{{ classNames }}">
    <view class="{{ classes.content }}">
        <icon wx:if="{{ icon && !hidden }}" class="{{ classes.icon }}" type="i-{{icon}}" size="36" color="#fff" />
        <text>{{ text }}</text>
    </view>
</wux-animation-group>
