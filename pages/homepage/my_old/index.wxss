.my-bg {
    height: 280rpx;
    width: 100%;
    background-size: 100% 100%;
    position: relative;
    border: none;
    border-color: transparent;
    /* background-color: #E63939; */
    background-image: url(https://bd-image.oss-cn-hangzhou.aliyuncs.com/e8v3/wx_my/bg.png);
    /* overflow: hidden; */
    font-weight: 300;
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
}

.my-bg .gif-wave {
    position: absolute;
    width: 100%;
    bottom: -1rpx;
    left: 0;
    mix-blend-mode: screen;
    height: 100rpx;
    border: none;
}

.trans {
    opacity: 0;
}

.my-options {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    background-color: white;
    box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1);
    color: #444;
}

.my-options-title {
    margin-top: 10rpx;
    font-size: 26rpx;
}

.my-options>.my-menu {
    text-align: center;
    /* flex: 1; */
    width: calc(100% / 4);
}

.my-system-options {
    margin: 20rpx auto;
    width: calc(100% - 40rpx);
    border-radius: 20rpx;
    background-color: white;
    box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1);
    font-size: 26rpx;
}

.margin-top {
    margin-top: 20rpx;
}



.my-system-menu {
    height: 84rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30rpx;
}

.left-view {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
}

.left-view view {
    margin-right: 10rpx;
}

.right-view {
    display: flex;
    align-items: center;
    height: 100%;
    color: #9e9c9c;
}

.my-foot-img {
    height: 164rpx;
    border-radius: 10rpx;
    overflow: hidden;
    margin: 20rpx;
}

.my-foot-img image {
    width: 100%;
    height: 100%;
}

.userAvatarUrl {
    display: block;
    width: 108rpx;
    height: 108rpx;
    overflow: hidden;
    border-radius: 100%;
    border: 4rpx solid#eee;
}

.my-top-panel {
    height: calc(100% - 50rpx);
    display: flex;
    align-items: center;
}

.avatar {
    height: 100%;
    min-width: 25%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20rpx;
}

.avatar-msg {
    width: 60%;
    /* height: 108rpx; */
    color: white;
}

.block {
    display: -webkit-box;
    /* width: 100%; */
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}

.avatar-msg .name {
    font-weight: bolder;
    font-size: 32rpx;
}

.avatar-msg .company,
.avatar-msg .role {
    font-size: 26rpx;
    color: #fff;
    /* color: rgba(255, 255, 255, 0.651); */
}

.avatar-qrcode {
    /* width: 25%; */
    /* height: 100%; */
    display: flex;
    align-items: center;
    /* justify-content: center; */
}

.qrcode {
    height: 48rpx;
    width: 48rpx;
    background-size: 100% 100%;
    position: relative;
    opacity: 0.651;
    margin: 10rpx;
}

.avatar-user {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 20rpx;
}

.avatar-user view {
    opacity: 0.5;
}

.logout {
    margin: 30rpx 0;
    height: 84rpx;
    background-color: white;
    line-height: 84rpx;
    text-align: center;
    /* box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1); */
}