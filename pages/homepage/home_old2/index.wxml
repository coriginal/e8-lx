<view class="box">
    <view class="top_bg">
        <view class="top_bg_circle"></view>
    </view>
    <swiper class="card-swiper square-dot'" indicator-dots circular autoplay interval="5000" indicator-color="#8799a3" indicator-active-color="#5c96ec" bindchange="cardSwiper">
        <swiper-item wx:for="{{swiperList}}" catchtap='swiperItemTap' id="{{item.code}}" data-code="{{item.name}}" wx:key class="{{cardCur==index?'cur':''}}">
            <view class="swiper-item">
                <image show-menu-by-longpress lazy-load src="{{item.url}}" mode="widthFix"></image>
            </view>
        </swiper-item>
    </swiper>
</view>
