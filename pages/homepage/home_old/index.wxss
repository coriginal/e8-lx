.divider {
  text-align: center;
  font-size: 20rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray);
  height: 36px;
  margin: 10rpx 10rpx;
}

.divider-line {
  position: absolute;
  left: 0;
  width: 96%;
  height: 2rpx;
  background-color: #e9eaec;
  top: 50%;
  margin: 0 2%;
}

.divider-content {
  background-color: rgb(245, 245, 245, 0.6);
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 0 10px;
}

.card-swiper {
  height: 400rpx !important;
  background-color: white;
}

.swiper-item image {
  width: 100%;
  display: block;
  height: auto;
  margin: 0;
  pointer-events: none;
}

.menu {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  justify-content: space-between;
  background-color: var(--white);
  display:-webkit-flex;
  -webkit-justify-content: space-between;
  -webkit-flex-wrap: wrap;
  -moz-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  -o-flex-wrap: wrap;
}

.m-li {
  padding: 30rpx;
  border-radius: 12rpx;
  width: 45%;
  margin: 0 2.5% 40rpx;
  background-image: url(https://tms.boudata.com/img/cardBg.png);
  background-size: cover;
  background-position: center;
  position: relative;
  z-index: 1;
  color: var(--white);
}

.m-li::after {
  content: "";
  position: absolute;
  z-index: -1;
  background-color: inherit;
  width: 100%;
  height: 100%;
  left: 0;
  bottom: -10%;
  border-radius: 10rpx;
  opacity: 0.2;
  transform: scale(0.9, 0.9);
}

.m-title {
  font-size: 32rpx;
  font-weight: 300;
}

.m-name {
  font-size: 28rpx;
  text-transform: Capitalize;
  margin-top: 20rpx;
  position: relative;
}

.m-name::before {
  content: "";
  position: absolute;
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #fff;
  bottom: 0;
  right: 0;
  opacity: 0.5;
}

.m-name::after {
  content: "";
  position: absolute;
  display: block;
  width: 100rpx;
  height: 1px;
  background: #fff;
  bottom: 0;
  right: 40rpx;
  opacity: 0.3;
}

.m-name::first-letter {
  font-weight: bold;
  font-size: 36rpx;
  margin-right: 1px;
}

.m-icon {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  width: 60rpx;
  height: 60rpx;
  text-align: center;
  line-height: 60rpx;
}

.wux-card {
  margin: 0 20rpx;
}

.card2 {
  margin-top: 20rpx;
}

.text-red {
  color: var(--red);
  text-decoration: underline;
}

.scroll_box {
  overflow: hidden;
  padding: 20rpx;
  white-space: nowrap;
}

.scroll_box:before {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 2rpx;
  border-top: 2rpx solid #eee;
  color: #eee;
  transform-origin: 0 0;
  transform: scaleY(0.5);
}

.item_list {
  width: 320rpx;
  height: 180rpx;
  margin: 0 20rpx;
  display: inline-block;
  background-color: #ddf0fe;
  border-radius: 12rpx;
  background-size: cover;
  background-position: center;
  position: relative;
  z-index: 1;
  color: var(--white);
  border: none;
}

.item-title {
  padding: 20rpx 20rpx 5rpx 20rpx;
  font-weight: 500;
  font-size: 30rpx;
}

.item-name {
  padding: 0 20rpx;
  font-size: 25rpx;
}



.box{
    width: 100%;
}
.logo{
    padding: 20rpx;
}
.logo image{
    height: 40rpx;
}
