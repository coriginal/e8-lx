<tabbar theme='positive' controlled position='bottom' current="{{_index}}" bindchange='onChange' wx:if="{{tabbarList.length}}">
    <tabbar-item wx:for="{{tabbarList}}" id="{{item.code}}" title="{{item.name}}" wx:key>
        <badge dot="{{item.name == '运营中心' && showDot}}" slot="icon-on">
            <icon color='#333' type="i-{{fn.icon(item.icon)[0]}}" />
        </badge>
        <badge dot="{{item.name == '运营中心' && showDot}}" slot="icon-off">
            <icon color='#E63939' type="i-{{fn.icon(item.icon)[1]}}" />
        </badge>
    </tabbar-item>
</tabbar>

<toptips id="wux-toptips" />


<canvasdrawer painting="{{painting}}" class="canvasdrawer" bind:getImage="eventGetImage" />

<landscap visible="{{ visible }}" bind:close="onClosePop">
    <image catchtap="goRedpacketPage" class="landscap" src="{{imgUrl}}" />
</landscap>

<wxs module="fn">
    module.exports = {
        icon: function (value) {
            return value.split('|')
        }
    }
</wxs>