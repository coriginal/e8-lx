<topbar hidden="{{code=='home'||code=='my'}}" title="{{name}}" showPop ifDot="{{ifDot}}" />
<!-- hidden="{{code=='home'||code=='my'}}" -->
<!-- <view class='page' style="height:calc(100vh - {{menuRect.bottom + menuRect.top - 20}}px - {{tabbarList.length && code!='home'?'92rpx':'0rpx'}});overflow:scroll;"> -->
<view style="padding-bottom: calc(100rpx + env(safe-area-inset-bottom));">
    <home tabbarList="{{tabbarList}}" user="{{user}}" class='home' wx:if="{{code=='home'}}" swiperList="{{swiperList}}"></home>
    <work wx:if="{{code=='work'}}"></work>
    <order wx:if="{{code=='order'}}"></order>
    <query-order wx:if="{{code=='router'}}"></query-order>
    <table wx:if="{{code=='table'}}" tableList="{{table_list}}"></table>
    <partner wx:if="{{code=='partner'}}"></partner>
    <my wx:if="{{code=='my'}}"></my>
    <oc eff_oc_count="{{eff_oc_count}}" wx:if="{{code=='oc'}}"></oc>
</view>
