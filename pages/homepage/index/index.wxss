/* ------ query_router ------ */

/* 未选中的 背景样式 */

radio.query_router .wx-radio-input {
    border-radius: 6rpx;
    background: transparent;
    transform: scale(0.85);
    border: 1rpx solid#eee;
}

/* 选中后的 背景样式 */

radio.query_router .wx-radio-input.wx-radio-input-checked {
    border-radius: 6rpx;
    background: transparent;
    border: 1rpx solid#eee;
}

/* 选中后的 对勾样式 */

radio.query_router .wx-radio-input.wx-radio-input-checked::before {
    color: #E63939;
    zoom: 2;
}