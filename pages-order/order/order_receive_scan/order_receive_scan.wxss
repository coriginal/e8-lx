.scan {
    margin-top: 5px;
    background: #fff;
    padding: 10px;
    display: flex;
}

.scan input {
    line-height: 38px;
    font-size: 16px;
    padding: 5px;
    width: 88%;
    height: 38px;
    background: #f1f3f5;
}

.signDetail {
    background: #fff;
    padding: 10px;
    margin-top: 5px;
}

.panpel {
    display: flex;
    margin-bottom: 5px;
    font-size: 15px;
}

.panpel text {
    color: #888;
    width: 78px;
}

.panpel input {
    width: 70%;
    padding: 0 5px 2px 5px;
    height: 25px;
    border-bottom: 1px solid #d9d9d9;
}

.receive-bottom-btn {
    margin-top: 30px;
}

.scan_choose image {
    height: 60px;
    width: 60px;
    border-radius: 100%;
    background: #fff;
    position: fixed;
    right: 20px;
    bottom: 36vh;
}