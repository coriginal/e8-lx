.addr {
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
}

.bar {
  display: flex;
  display: -webkit-flex;
  justify-content: space-between;
  -webkit-justify-content: space-between;
  align-items: center;
  -webkit-align-items: center;
  min-height: 84rpx;
  background-color: white;
  padding: 20rpx;
  color: #444;
}

.solid {
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
}

.my-system-options {
  background-color: white;
  padding: 0 30rpx;
  box-shadow: 0 -1rpx 6rpx rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
}

.my-system-menu {
  height: 84rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  display: -webkit-flex;
  -webkit-justify-content: space-between;
  -webkit-align-items: center;
}

.left-view {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  display: -webkit-flex;
  -webkit-align-items: center;
}

.left-view view {
  margin-right: 10rpx;
}

.right-view {
  display: flex;
  align-items: center;
  height: 100%;
  color: #9e9c9c;
  display: -webkit-flex;
  -webkit-align-items: center;
}

.my-system-notice {
  color: var(--blue);
  font-size: 26rpx;
  margin-left: 15rpx;
}

.opcity {
  opacity: 0.6;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 20rpx 0;
  background-color: white;
  z-index: 999;
  display: -webkit-flex;
}

.bottom-btn button {
  flex: 1;
  height: 84rpx;
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
