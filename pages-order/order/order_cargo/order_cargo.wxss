.input-panel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 96rpx;
    background-color: white;
    padding: 0 20rpx;
}

.input-panel .title {
    padding-right: 30rpx;
    font-size: 28rpx;
    white-space: nowrap;
}

.input-panel input {
    flex: 1;
}

.input-panel .flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.scan {
    color: var(--grey);
}

.input_grids {
    display: flex;
    align-items: center;
}

.input_grids_list {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.input_grids_list button {
    height: 60rpx;
    line-height: 60rpx;
    font-size: 30rpx;
    background-color: var(--blue);
    color: white;
}

.input_grids_list input {
    border: 1rpx solid #eee;
    margin: 0 5rpx;
    min-height: 64rpx;
}

.table {
    width: 100%;
    border: 1rpx solid gainsboro;
}

.table .table-title {
    font-weight: bold;
}

.table .table-item,
.table .table-title {
    display: flex;
}

.table .table-title view,
.table .table-item view {
    width: 20%;
    text-align: center;
    background-color: whitesmoke;
    height: 70rpx;
    line-height: 70rpx;
}

.table .table-title view:nth-child(2n),
.table .table-item view:nth-child(2n) {
    border-left: 1rpx solid gainsboro;
    border-right: 1rpx solid gainsboro;
}
.table .table-item:nth-child(2n){
    border-top: 1rpx solid gainsboro;
    border-bottom: 1rpx solid gainsboro;
}
.table .table-item:last-child{
    border-bottom: none;
}
.text-center {
    text-align: center;
}

.input_grids input {
    border: 1rpx solid #eee;
    margin: 0 20rpx;
    min-height: 64rpx;
}

.grids {
    width: 100%;
    padding-bottom: 20rpx;
}



.wux-grid__inner {
    padding: 20rpx !important;
}

.bottom-btn {
    position: fixed;
    bottom: 0;
    width: 100%;
    display: flex;
    padding: 30rpx 0 calc(30rpx + env(safe-area-inset-bottom));
    background-color: white;
    z-index: 999;
}

.bottom-btn button {
    flex: 1;
    height: 84rpx;
}

.m-p {
    margin: 0 20rpx;
    padding: 20rpx 32rpx;
    border-radius: 6rpx;
    height: 84rpx;
    font-weight: 500;
}

.margin-top {
    margin-top: 20rpx;
}

.pack {
    margin: 12rpx;
    padding: 15rpx 10rpx;
    border-radius: 10rpx;
    color: gray;
    text-align: center;
}

.fade {
    padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
}

.choosed {
    background-color: var(--blue);
    color: white;
}

.navigate {
    min-height: 64rpx;
}

.stepper-input{
  background: white !important;
  color: #3c9cff !important;
  font-size: 24px !important;
  font-weight: bold;
}
.stepper-plus{
  background: white !important;
}
.stepper-minus{
  background: white !important;
}
.cargo-tags{
  display: grid;
  grid-template-columns: repeat(3,1fr);
  text-align: center;
  row-gap: 12px;
  column-gap: 24px;
  margin-top: 12px;
}
.tags-box{
  background-color: white;
  padding: 12px;
}
.tag{
  padding:12px;
  height: 36px;
  width: 100%;
  border-radius: 18px;
  border: 1px solid #909399;
  display: flex;
  align-items: center;
  justify-content: center;
}
.active-tag{
  background-color: #3c9cff;
  color: white;
  border: 1px solid #3c9cff;
}
/* D1005 物品选择器 */
.cargo-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 96rpx;
  background-color: white;
  padding: 0 20rpx;
  flex: 1;
}

.cargo-selector-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-height: 60rpx;
}

.cargo-selected-text {
  font-size: 28rpx;
  color: #333;
  margin-right: 8rpx;
}

.cargo-placeholder {
  font-size: 28rpx;
  color: #c8c9cc;
  margin-right: 8rpx;
}
