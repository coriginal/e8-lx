switch .wx-switch-input:not([checked]) {
    background: var(--ghostWhite) !important;
}

switch::after,
switch::before {
    font-family: "i";
    content: "";
    position: absolute;
    color: var(--white) !important;
    top: 1px;
    left: 0rpx;
    font-size: 26rpx;
    line-height: 26px;
    width: 50%;
    text-align: center;
    pointer-events: none;
    transform: scale(0, 0);
    transition: all 0.3s ease-in-out 0s;
    z-index: 9;
    bottom: 0;
    height: 26px;
    margin: auto;
}

switch::before {
    content: "";
    right: 0;
    transform: scale(1, 1);
    left: auto;
}


.container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

.container camera,
.camerabox {
    width: 100%;
    height: 100px;
    position: relative;
    background: #8f939c;
    color: white;
}

.camerabox text {
    position: absolute;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 30px;
    line-height: 100px;
}

.container .list {
    width: 100%;
    padding: 10px;
    margin: 0 auto;
    margin-top: 8px;
    background-color: white;
}
.golink{
    color: #2979ff;
    text-decoration: underline;
}

.item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
}

.printerList {
    height: 50vh;
    width: 100%;
    margin-top: 8px;
    flex: 1;
    background: white;
    overflow: scroll;
    padding: 0 10px;
}

.printer {
    width: 100%;
    height: 60px;
    background: whitesmoke;
    box-sizing: border-box;
    border-radius: 10px;
    margin: 10px 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
}

.printer image {
    padding: 10px;
    width: 50px;
    height: 50px;
    display: block;
    background: white;
    border-radius: 25px;
}

.printInfo {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-left: 10px;
}

.printInfo text:nth-child(1) {
    font-size: 15px;
    font-weight: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    width: 350rpx;
}

.printer text:nth-child(3) {
    font-size: 15px;
    width: 80px;
    text-align: center;
}

.status {
    height: 80px;
    border-radius: 40px;
    line-height: 80px;
}

.status:active {
    background: white;
}

.title {
    padding: 5px 0;
    height: 30px;
    display: flex;
    align-items: center;
    font-weight: bold;
    border-bottom: 1px solid whitesmoke;
}

.title image {
    width: 20px;
    height: 20px;
}

.title text {
    margin-left: 5px;
}

.lockContainer {
    width: 100%;
    height: calc(100% - 30px);
    position: relative;
}

.lock {
    width: 100%;
    height: 100%;
    background: gray;
    opacity: 0.2;
}

.lockContainer image {
    position: absolute;
    width: 100px;
    height: 100px;
    top: calc(50% - 50px);
    left: calc(50% - 50px);
}

.inputBoxCode {
    width: 100%;
    height: 200rpx;
    background: white;
    padding: 0 20rpx 20rpx;
    display: flex;
    flex-direction: column;
}

.inputBoxCode input {
    width: 100%;
    background: whitesmoke;
    height: 80rpx;
    text-align: center;
}
.inputBoxCode .btn-box{
    margin-top: 20rpx;
    display: flex;
    flex-direction: row;
}
.inputBoxCode .btn-box button{
    height: 80rpx;
    line-height: 80rpx;
    flex: 1;
    text-align: center;
    border-radius: 0;
}
.clear{
    background: #8f939c;
    color: white;
    margin-right: 10rpx;
}
.print{
    background: #2979ff;
    color: white;
    margin-left: 10rpx;
}
.inputNull {
    opacity: 0.5;
}
.type_box{
    width: 100%;
    margin:0 auto 0;
    white-space: nowrap;
    background-color: white;
    padding:20rpx;
}
.type_box>view{
    display: inline-block;
}
.type_box .item{
    height: 50rpx;
    line-height: 48rpx;
    margin:0 5rpx;
    border-radius: 5rpx;
    border: 1rpx solid #8f939c;
    padding: 0 15rpx;
    color:#8f939c;
}
.type_active{
    border: 1rpx solid #2979ff !important;
    color:#2979ff !important;
}
.page-container{
}
.scan-log-box{
    flex: 1;
    background-color: white;
    margin-top: 10rpx;
    padding: 20rpx;
    overflow: auto;
}
.scan-log-box .log-items{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    border-bottom: 2rpx solid whitesmoke;
    height: 80rpx;
    line-height: 80rpx;
}
.left,.mid,.right{
    text-align: center;
    flex: 1;
}
.left{
    border-right: 1rpx solid whitesmoke;
}
.right{
    border-left: 1rpx solid whitesmoke;
}
.scan-log-box .mid{
    color: #2979ff;
    border-right: 2rpx solid whitesmoke;
    border-left: 2rpx solid whitesmoke;
}
.scan-log-box .right{
    color: #8f939c;
}