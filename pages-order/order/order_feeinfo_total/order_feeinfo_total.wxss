.feeinfo-content {
  background-color: white;
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 10rpx;
  overflow: scroll;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 144rpx;
}

.placeorder {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
}

.placeorder view {
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.add-fee {
  display: flex;
  align-items: center;
  color: var(--grey);
}

.add-fee view {
  padding-right: 6rpx;
}

.opcity {
  opacity: .8;
}

.placeorder-flex {
  display: flex;
  align-items: center;
  display: -webkit-flex;
  -webkit-align-items: center;
  position: relative;
}


.person-msg view {
  margin-left: 8rpx !important;
}

.flex-1 {
  flex: 1;
}

.t-margin-left {
  margin-left: 15rpx;
  font-size: 30rpx;
}

.placeorder-flex.t-center {
  justify-content: center;
}

.title-big {
  font-weight: bold;
  font-size: 18px;
}

.text-underline {
  position: absolute;
  bottom: 0;
  min-width: 16.666%;
  height: 6rpx;
  left: 0;
  background-color: var(--grey);
  color: var(--white);
}

.padding {
  padding: 0 30rpx;
}

.fee-total {
  color: var(--red);
  font-weight: bold;
}


.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 30rpx 0;
  background-color: white;
  z-index: 999;
}

.bottom-btn button {
  flex: 1;
  height: 84rpx;
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
}

.margin-top {
  margin-top: 20rpx;
}

.t-color {
  color: var(--red);
  font-weight: bold;
  opacity: 0.8;
}

.t-value {
  position: relative;
}

.t-value::before {
  content: '¥';
  padding-right: 6rpx;
  font-size: 11px;
}

.sp-btn {
  padding-left: 35rpx;
  color: var(--red);
  font-weight: bold;
}

.t-f26 {
  font-size: 26rpx !important;
}

.translate {
  transform: translate(1rpx, 1rpx);
}

.col-disabled {
  color: gray !important;
}

.dialog-view {
  position: relative;
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.bill-model {
  white-space: nowrap;
  border: 1px solid#eee;
  margin: 10rpx;
  border-radius: 1000rpx;
  padding: 10rpx 20rpx;
}

.choosed {
  border-color: var(--blue);
  background-color: var(--blue);
  color: white;
}