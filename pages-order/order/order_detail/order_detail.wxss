@import '../order_list/order_list.wxss';

swiper {
  height: calc(100vh - 64rpx);
  width: 100%;
}

.item {
  height: 100%;
  overflow: scroll;
  /* padding: 10rpx; */
  -webkit-overflow-scrolling: touch;
}
.foot{
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 10rpx;
  background-color: white;
}
.foot .btn{
  height: 84rpx;
  flex: 1;
  border-radius: 6rpx;
  margin: 0 10rpx;
}
.line{
  color: var(--blue);
}
.choose::before{
  border-color: var(--blue)
}

.cc-work {
  padding: 10rpx;
  background-color: white;
  height: 100%;
  margin-bottom: 154rpx;
}

.timeline-slot {
  padding: 10rpx 0 0 30rpx;
  line-height: 1.6;
  font-size: 26rpx;
  color: rgb(102, 99, 99);
  display: flex;
  align-items: center;
}


.nothing {
  height: 100vh;
  text-align: center;
}

.nothing text {
  line-height: 80vh;
}

.text-bold {
    font-weight: bold;
}

/* 保存为图片 */
.with-save-foot swiper {
  height: calc(100vh - 64rpx - 110rpx);
}

/* 组件底部操作栏：swiper 内 transform 会使 fixed 相对 swiper 定位，
   swiper 高度已预留 110rpx，bottom:0 即紧贴「保存为图片」栏上方，无需额外抬升 */
.with-save-foot .bottom-btn {
  bottom: 0;
}

.save-foot {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 12rpx 20rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
  z-index: 1000;
  box-sizing: border-box;
}

.save-foot .btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 离屏隐藏的绘制画布 */
.save-canvas {
  position: fixed;
  top: 0;
  left: 9999rpx;
  width: 350px;
  height: 1000px;
}