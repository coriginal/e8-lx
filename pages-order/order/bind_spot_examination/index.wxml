<view id="box" class="box">
    <view wx:if="{{!isCustomer}}" class="text-gray customer_choose_box {{customerInfo && 'has_customer_info'}}" bindtap="toChooseCustomer">
        -- {{customerInfo.name || '点击此处选择客户'}} --
    </view>
    <view class="addr_box">
        <view class="send_box">
            <image mode='widthFix' src='../../../images/send.png'> </image>
            <view class="info">
                <view bindtap="goEditAddr" id="send">
                    <view>{{form.send_man|| '新建寄件人信息'}} {{form.send_phone||''}}</view>
                    <view>{{(form.send_province+form.send_city+form.send_district+form.send_town+form.send_street_no)||'可智能粘贴至寄件人'}}</view>
                </view>
                <view bindtap="goChooseAddr" id="send">地址簿</view>
            </view>
        </view>
        <view class="receive_box">
            <image mode='widthFix' src='../../../images/receive.png'> </image>
            <view class="info">
                <view bindtap="goEditAddr" id="receive">
                    <view>{{form.receive_man|| '新建收件人信息'}} {{form.receive_phone}}</view>
                    <view>{{(form.receive_province+form.receive_city+form.receive_district+form.receive_town+form.receive_street_no)||'可智能粘贴至收件人'}}</view>
                </view>
                <view bindtap="goChooseAddr" id="receive">地址簿</view>
            </view>
        </view>
        <view class="addr_bottom">
            <!-- <view class="copy_content bg-blue">浙江省杭州市钱塘区下沙路浙江省杭州市钱塘区下沙路浙江省杭州市钱塘区下沙路浙江省</view> -->
            <view></view>
            <view bindtap="pasteAddress">
                <icon color='#E63939' type='i-formfill' size='32' />
                <view style="margin-left: 20rpx;color:#333">智能粘贴</view>
            </view>
        </view>
    </view>
    <view class="platform-box" animation="{{animationList[0]}}" hidden="{{hidePlatformList}}">
        <view class="select-type-box">
            <view bind:tap="opChecked" data-type="{{0}}">
                反选
            </view>
            <view bind:tap="opChecked" data-type="{{1}}">
                全选
            </view>
            <view bind:tap="opChecked" data-type="{{2}}">
                全不选
            </view>
        </view>
        <checkbox-group bindchange="checkboxChange">
            <label class="platform-list" wx:for="{{platformInfoList}}" wx:key="{{item.sign}}">
                <view>{{item.name}}</view>
                <view hidden="{{hidePlatformList}}">
                    <checkbox data-index="{{index}}" bind:tap="itemChecked" value="{{item.sign}}" checked="{{item.checked}}" />
                </view>
            </label>
        </checkbox-group>
    </view>
    <view animation="{{animationList[1]}}" class="platform-box" hidden="{{hide}}" style="opacity: 0;">
        <!-- 暂时对客户做了屏蔽 -->
        <label data-index="{{index}}" bind:tap="{{item.search_status && !isCustomer?'openDetail':''}}" class="platform-list click-detail" wx:for="{{resultList}}" wx:if="{{!isCustomer || item.search_status}}" wx:key="{{item.sign}}">
            <view>{{isCustomer?item.platform_real_name:item.platform_name}}</view>
            <view wx:if="{{item.search_status}}" class="has-info">
                <view>{{item.network_name||''}}</view>
                <icon wx:if="{{!isCustomer}}" size='30' type='i-right' />
            </view>
            <view wx:else style="color:var(--red)">{{item.status_info}}</view>
        </label>
    </view>
    <!-- <view class="detail_info_box">
        <view class="code_box">
            <input value="{{form.code}}" bindinput="inputCode" type="text" placeholder="请填写单号（至少4位）可不填" />
            <icon bindtap="scanCode" type="i-scan" size="36"></icon>
        </view>
        <view class="noname_box">
            <view>
                <view>上门取件</view>
                <switch style="transform: scale(0.8);" bindchange="switchChange" class='blue' name='if_visit' checked="{{form.if_visit}}"></switch>
            </view>
            <view>
                <view bindtap="showChooseSettleType">{{form.settle_type}}</view>
                <icon size="24" type="i-unfold " />
                <view hidden="{{hideChooseSettleType}}" class="fly_box">
                    <view wx:key="{{item}}" id="{{item}}" bindtap="chooseSettleType" wx:for="{{settleTypeList}}">{{item}}</view>
                </view>
            </view>
            <view>
                <view bindtap="showChooseServiceMode">{{form.service_mode}}</view>
                <icon size="24" type="i-unfold" />
                <view hidden="{{hideChooseServiceMode}}" class="fly_box">
                    <view wx:key="{{item}}" id="{{item}}" bindtap="chooseServer" wx:for="{{serviceModeList}}">{{item}}</view>
                </view>
            </view>
        </view>
        <view wx:for="{{form.subOrders}}">
            <view>货物信息{{form.subOrders.length>1?' '+(index+1):''}}</view>
            <view class="text-gray right_box">
                <view class="overflow" bindtap="goCargoInfo" data-index="{{index}}">{{item.message||'点击填写货物信息'}}</view>
                <icon bindtap="{{index>0?'delCargoItem':'addCargoItem'}}" class="text-blue" type="i-{{index>0?'delete':'roundadd'}}" size='32' data-index="{{index}}" />
            </view>
        </view>
        <view>
            <view>预约取件时间</view>
            <view class="text-gray right_box" bindtap="getPickTimes">
                {{form.scheduled_pick_time||'选择时间'}}
                <icon class="text-blue" type="i-right" size='32' />
            </view>
        </view>
        <view>
            <view>
                增值服务
            </view>
            <view bindtap="goFeeInfo" class="text-gray right_box">
                <view class="overflow">
                    {{form._fees||'更多'}}
                </view>
                <icon class="text-blue" type="i-right" size='32' />
            </view>
        </view>
        <view>
            <view>
                其他
            </view>
            <view class="text-gray right_box" bindtap="goOtherInfo">
                <view class="overflow">
                    {{curRecords ||'点击填写其他信息'}}
                </view>
                <icon class="text-blue" type="i-right" size='32' />
            </view>
        </view>
        <view>
            <view>
                备注
            </view>
            <view class="text-gray right_box">
                <input bindinput="remarkInput" type="text" placeholder="点击此处可填写备注" />
            </view>
        </view>
    </view>
    <view wx:if="{{platFormPriceList.length}}" class="price_box">
        <view data-index="{{index}}" data-platform="{{item}}" bindtap="choosePlatForm" wx:if="{{item.search_status}}" wx:for="{{platFormPriceList}}">
            <view class="price_top {{currentSelectPlatForm.index==index?'text-bold bg-blue':'bg-gray'}}">
                {{isCustomer?item.platform_real_name:item.platform_name}}
            </view>
            <view class="{{currentSelectPlatForm.index==index?'text-red text-bold':'text-orange'}} price">
                ¥ {{item.cost}}
            </view>
        </view>
    </view> -->
</view>
<view class="bottom_bar">
    <!-- <view class="bar_left bg-black">
        <view>预估价格：<span class="price_title">{{currentSelectPlatForm['cost'] || '--'}}</span> ¥</view>
    </view>
    <view class="bar_right" bindtap="save">
        下单
    </view> -->
    <block wx:if="{{status}}">
        <view class="bar-btn " bind:tap="reSearch">
            重新查询
        </view>
        <view class="bar-btn bg-green" bind:tap="toWriteOrder">
            去录单
        </view>
    </block>
    <view wx:if="{{!status}}" class="bar-btn" bind:tap="search">
        查询盲区
    </view>
</view>
<!-- <pick-time showPickTime="{{showPickTime}}" bind:change="changePickTime" /> -->
<page-container show="{{showDetail}}" position="bottom">
    <!-- <view class="otherContainer" wx:for="{{recordsList}}">
        <view>{{item.label}}:</view>
        <input data-label="{{item.label}}" id="{{item.code}}" bindinput="recordInput" class="t-left t-f24" name='{{item.code}}' value='{{form.recordsList["udf"+(index+1)]}}' />
    </view>
    <view class="btn bg-blue page-bottom" bindtap="setRecords">
        确定
    </view> -->
    <view class="pg-box">
        <view class="title">{{isCustomer?current.platform_real_name:current.platform_name}}</view>
        <view>匹配的网点：{{current.network_name}}</view>
        <view style="display: flex;flex-direction: row;">
            <view style="white-space: nowrap;">派送及区域详情：</view>
            <view style="background: whitesmoke;padding: 10rpx;border-radius: 10rpx;">
                <view wx:for="{{current.delivery_details}}" wx:key="{{index}}">
                    <view>{{item.l}}：{{item.v}}</view>
                </view>
            </view>
        </view>
        <view>其他信息：{{current.network_remark||'无'}}</view>
    </view>
</page-container>