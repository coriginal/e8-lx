                <view class="placeorder-flex solid-bottom">
                    <text class="t-fw fee-total flex-1"></text>
                    <input value="{{rcode_street_no}}" name="rcode_street_no" style="height: 84rpx;text-align: right;padding-right: 30rpx;" class="placeorder-input" placeholder-class="opcity8" placeholder="请输入详细地址"></input>
                </view>
            </view>
            </col>
        </row>
        <row wx:if="{{_options.if_up}}">
            <col span="12">
