<wxs module="utils">
    function includes(str, str1) {
        if (str.length) {
            return str.indexOf(str1) !== -1
        }
        return false
    }
    module.exports.includes = includes;
</wxs>
<view class="fade">
    <form bindsubmit="formSubmit">
        <row>
            <col span="12" class="">
            <view class="placeorder">
                <view class="placeorder-flex">
                    <text class="title-big">增值服务</text>
                    <text class="text-underline"></text>
                </view>
            </view>
            </col>
        </row>

