/* pages-order/order/scan_up_platform/index.wxss */
Page {
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.bottom_box {
    position: fixed;
    bottom: 0;
    width: 100%;
    background-color: white;
    padding-bottom: env(safe-area-inset-bottom);
}

.bottom_bar {
    height: 120rpx;
    line-height: 120rpx;
    text-align: center;
    padding: 0 20rpx;
}

.bottom_bar .button {
    width: 100%;
    height: 80rpx;
    border-radius: 40rpx;

}

.search_bar {
    width: 100%;
    height: 80rpx;
    display: flex;
    align-items: center;
    background-color: white;
    padding: 0 20rpx
}

.search_bar input {
    flex: 1;
    border-radius: 30rpx;
    background-color: whitesmoke;
    width: 80%;
    height: 60rpx;
    padding: 0 30rpx
}

.search_bar icon {
    width: 80rpx;
    text-align: center;
}

.form_box radio-group {
    display: flex;
    flex-direction: column;
    padding: 10rpx 20rpx;
}

.form_box .box {
    height: 80rpx;
    background: white;
    border-radius: 20rpx;
    margin: 10rpx 0;
    display: flex;
    align-items: center;
    padding: 20rpx;
}
.item_content{
    height: 100%;
    flex: 1;
    display:flex;
    flex-direction:row;
    justify-content:space-between;
    align-items: center;
    padding: 0 20rpx;
}
.item_content view:first-child{
    font-size: 28rpx;
}
.order_info_box{
    background:white;
    width: 100%;
    padding: 20rpx 20rpx 0;
}
.order_info_box .title{
    font-size: 32rpx;
}
.order_info_box image{
    width: 50rpx;
    height: 50rpx;
    margin-right: 20rpx;
}
.addr{
    margin: 20rpx 0;
    display: flex;
    flex-direction: row;
    align-items: center;
}
.addr_box{
    font-size: 24rpx;
    width: 100%;
    display: flex;
    flex-direction: column;
}
.addr_box>view{
    width: 600rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.awv_box{
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 50rpx;
    font-size: 26rpx;
}
.awv_box>view{
    color: gray;
    height: 50rpx;
    line-height: 50rpx;
    flex: 1;
    text-align: center;
    border-top: 1rpx solid whitesmoke;
}
@keyframes checked{
    from{
        box-shadow: none;
        font-weight: normal;
    }
    to{
        box-shadow: 0 0 6rpx 6rpx gainsboro;
        font-weight: bold;
    }
}
.box_checked{
    animation: checked .2s ease-in forwards;
}