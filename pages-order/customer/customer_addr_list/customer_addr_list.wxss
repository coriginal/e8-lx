.new-search{
  position: fixed;
  top: 0;
  width: 100vw;
  z-index: 999999;
}
.tabs{
  position: fixed;
  top: 0;
}


.addr_list {
  margin-top: calc(66px);
  padding: 0 20rpx;
  padding-bottom: calc(55px + env(safe-area-inset-bottom) + 40rpx);
}
.customer_panel {
  position: relative;
  padding: 12px 12px 4px;
  background-color: white;
  border-radius: 6rpx;
  margin-top: 12px;
  display: flex;
  border-radius: 8px;
}

.skeleton {
  width: 100%;
}

.default-tag {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
}

.content-addr {
  padding: 4px;
  flex: 1;
}

.content-addr .name {
  padding-bottom: 10rpx;
  color: #444;
}

.content-menu {
  padding: 0 10rpx 0;
  display: flex;
  font-size: 26rpx;
  align-items: center;
  flex-direction: row;
  justify-content: space-between;
}
.content-menu-left{
  display: flex;
  flex-direction: row;
  align-items: center;
}

.icon {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 0 0 20rpx;
}

.addr.padding-bottom {
  padding-bottom: 10rpx;
}

.margin-top {
  margin-top: 30rpx;
}

.text-black {
  color: #333;
  font-weight: bold;
  font-size: 36rpx;
}

.text-grey {
  color: #8799a3;
  margin-top: 20rpx;
  font-size: 24rpx;
}

.width {
  width: 64%;
  height: 84rpx;
}

.flex-1 {
  display: flex;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  align-items: center;
  margin-top: 33.33%;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 20rpx 12px calc(20rpx + env(safe-area-inset-bottom));
  background-color: white;
  z-index: 999;
}

.bottom-btn button {
  flex: 1;
  height: 84rpx;
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
}

.edit view, .delete view {
  margin-right: 5rpx;
}

.btn-trans{
  height: auto;
}

.btn-trans:first-child {
  padding-left: 0;
}

.edit, .delete{
  color: var(--darkGray);
}

.default1 {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.btn-default {
  color: var(--darkGray);
}

.btn-trans {
  background-color: transparent;
}

.no-margin {
  margin: 0;
  padding: 0 20rpx !important;
}

.padding.cancel {
  padding: 20rpx;
  border-top: 1px solid#eee;
}

.more-menu {
  display: flex;
  align-items: center;
}

.round {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: space-around;
  padding: 20rpx 0;
}

.flex-icon {
  height: 96rpx;
  width: 96rpx;
  border-radius: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f4f4f4;
  margin: 20rpx;
}

.hover-round {
  background-color: #eee;
  opacity: 0.7;
}


/* search */
.bar {
  background-color: white;
  position: fixed;
  width: 100%;
  top: 0;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  height: 100rpx;
  z-index: 999;
}

.bar .title {
  display: flex;
  align-items: center;
}


.search-form {
  background: #f5f5f5;
  line-height: 64rpx;
  height: 64rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  border-radius: 10rpx;
}

.search-form view {
  margin: 0 15rpx;
}

.search-form input {
  flex: 1;
  padding-right: 20rpx;
  font-size: 26rpx;
}