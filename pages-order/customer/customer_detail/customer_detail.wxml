<form bindsubmit="confirmCustomer">
	<view class='top t-bar'>
		<view class='title'>
			<text>基础信息</text>
			<text />
  </view>
  <view wx:if="{{customer.type != '虚拟客户'}}" class="edit-customer {{type=='detail'?'text-blue':'text-red'}}"  bindtap="editCustomer">
   <icon type="i-settings"  size="36" ></icon> {{type=='detail'?'编辑':'取消编辑'}}
  </view>
</view>

<view class='addr'>
  <view class="bar solid-bottom" wx:for='{{list}}' wx:key>
    <view class='title'>{{item.title}}</view>
    <input disabled="{{type=='detail'||item.disabled}}" placeholder-class='pclass' placeholder="{{item.defaultInput}}" name='{{item.code}}' value='{{customer[item.code]}}'></input>
    <tag wx:if="{{item.required}}" color="red">必填</tag>
  </view>
</view>

<view class='other t-bar' wx:if="{{!user.isCustomer}}" >
  <view class=' title'>
    <text>其他信息</text>
			<text />
  </view>
</view>
<view class='other addr' wx:if="{{!user.isCustomer}}">
  <view class="bar solid-bottom" wx:for='{{otherList}}' wx:key>
    <view class='title'>{{item.title}}</view>
    <input disabled="{{type=='detail'}}" placeholder-class='pclass' placeholder="{{item.defaultInput}}" name='{{item.code}}' value='{{customer[item.code]}}'></input>
    <tag wx:if="{{item.required}}" color="red">必填</tag>
  </view>
</view>
<!-- 暂不支持修改删除 -->
<view wx:if="{{type!='detail'}}" class='bottom-btn fade'>
  <!-- <button class='btn bg-red m-p' catchtap='deleteCustomer'>删除</button> -->
  <button class='btn bg-blue m-p' form-type="submit">保存</button>
</view>
</form>