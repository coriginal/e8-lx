<view class="bar">
	<view class='search'>
		<view class='search-form'>
			<icon size='36' type='i-search' />
			<input bindconfirm="searchCode" bindinput="bindKeyInput" placeholder="关键词过滤（姓名）" type="text" />
		</view>
	</view>
</view>

<view class='customer_list fade' wx:if="{{list.length}}">
	<view class='customer_panel' wx:for="{{list}}" wx:key data-item="{{item}}" catchtap='chooseCustomer' hover-class="hover-round">
		<view class="head {{index==0 && 't-fw'}}">
			<view class="flex-1 ">
				<text wx:if="{{item.name}}" class='name'>{{item.name||''}}</text>
				<!-- <text wx:if="{{item.phone}}" class="phone">{{fn.secretPhone(item.phone||'',4,-4)}}</text> -->

			</view>
			<view class='type'>
				<text wx:if="{{item.amount}}"> {{item.amount}} 票</text>
				<icon type="i-right"></icon>
			</view>
			<!-- <view class="type" color="#444" size="40" wx:else>
				<icon type="i-right"></icon>
			</view> -->
		</view>
	</view>
</view>