.addr {
  padding: 0 20rpx;
  /* margin-top: 12rpx; */
  background-color: white;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.1);
}
.addr_used{
  padding: 20rpx;
  background-color: #eee;
}

.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
  position: relative;
}


.bar input {
  flex: 1;
  height: 100rpx;
}

.bar picker {
  flex: 1;
}

.bar .title {
  padding-right: 30rpx;
  font-size: 26rpx;
}

.content-menu {
  font-weight: 300;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
}

.content-menu button {
  flex: 1;
  text-align: center;
}

.content-menu view {
  margin-right: 10rpx;
}

.content-menu>button:nth-child(2) {
  border-radius: 0;
  border-left: 1rpx solid #5a6b92;
  border-right: 1rpx solid #5a6b92;
}

.content-menu .btn {
  background-color: transparent;
}

.content-menu .btn.button-hover {
  transform: none;
}

.panel-textarea {
  margin-top: 12rpx;
  background-color: white;
  padding: 20rpx 0;
  min-height: 100rpx;
  position: relative;
  margin-bottom: 154rpx;
}

.absolute {
  text-align: right;
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
}

.absolute-ai {
  text-align: right;
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
}

.green-light {
  color: #39b54a !important;
  background: #d7f0db !important;
}

.textarea {
  padding: 20rpx;
  margin: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 10rpx;
  position: relative;
}

.panel-textarea textarea {
  height: 100rpx;
  width: 100%;
  display: block
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  padding: 30rpx 0;
  background-color: white;
  z-index: 999;
}

.m-p {
  margin: 0 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 6rpx;
  height: 84rpx;
  font-weight: 500;
}

.bg-red.m-p {
  flex: 1;
}

.bg-blue.m-p {
  flex: 4;
}

.margin-bottom{
  margin:20rpx 0 94rpx;
}

.cell-btn{
  width: 100%;
  height: 84rpx
}

.list-box{
    width: 100%;
    min-height: 200px;
    background-color: white;
    position: absolute;
    border-radius:0 0 20rpx 20rpx;
    top: 50px;
    z-index:9999;
    box-shadow: 0 0 5px rgba(216,216,216,.5);
    display: flex;
    flex-direction: column
}
.list-box .list{
    width: 100%;
    max-height: 204px;
    padding:0 20rpx;
}
.list-box .list .address{
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 10rpx;
    color: #c7c7c7;
}
.list-box .list .company{
    margin-top: 10rpx;
    color: #909399;
}
.list-box .list .search-list{
    border-bottom: 1rpx solid #ededed;
    padding:20rpx 0;
}
.list-box .list .name-phone{
    font-size: 32rpx;
    font-weight: bold;
}
.list-box .close-button{
    height: 40px;
    text-align: center;
    line-height: 40px;
    box-shadow: 0 -5px 10px -5px rgba(216,216,216,.5);
}